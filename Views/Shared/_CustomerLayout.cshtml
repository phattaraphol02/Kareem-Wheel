@{
    Layout = null;
}
@using Microsoft.AspNetCore.Http
@{
    // ดึงชื่อผู้ใช้มาเก็บไว้ในตัวแปร และดึงตัวอักษรตัวแรกมาทำเป็น Avatar
    var customerName = Context.Session.GetString("Customer_Name") ?? "ลูกค้า";
    var avatarInitial = !string.IsNullOrEmpty(customerName) ? customerName.Substring(0, 1).ToUpper() : "C";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kareem Wheel</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;900&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            :root {
                --rim-orange: #FF9760;
                --rim-orange-hover: #F37C3B;
                --rim-orange-light: #FFF2EB;
                --rim-bg-light: #F9FAFB;
                --rim-border: #EAEAEA;
                --rim-card: #FFFFFF;
                --rim-text-main: #2D2D2D;
                --rim-text-muted: #8A8A8A;
            }

            body {
                background-color: var(--rim-bg-light);
                font-family: 'Kanit', sans-serif;
            }

            .admin-navbar {
                background: #fff;
                height: 70px;
                border-bottom: 1px solid var(--rim-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .admin-logo {
                font-family: 'Montserrat', sans-serif;
                font-weight: 900;
                font-size: 1.5rem;
                color: #2D2D2D;
                text-decoration: none;
            }

                .admin-logo span {
                    color: var(--rim-orange);
                }

            .cart-icon-link {
                position: relative;
                color: var(--rim-text-main);
                font-size: 1.4rem;
                text-decoration: none;
                transition: 0.2s;
            }

                .cart-icon-link:hover {
                    color: var(--rim-orange);
                }

            .cart-badge {
                position: absolute;
                top: -6px;
                right: -10px;
                background-color: var(--rim-orange);
                color: #fff;
                font-size: 0.7rem;
                font-weight: 600;
                border-radius: 50%;
                width: 18px;
                height: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* --- 🔔 ป้ายสีแดงสำหรับแจ้งเตือน --- */
            .notification-badge {
                position: absolute;
                top: -6px;
                right: -6px;
                background-color: #E53935; /* สีแดงเด่นๆ */
                color: #fff;
                font-size: 0.7rem;
                font-weight: bold;
                border-radius: 50%;
                width: 18px;
                height: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                animation: pulse-red 2s infinite; /* เพิ่มเอฟเฟกต์กระพริบนิดๆ ให้ดูน่าสนใจ */
            }

            @@keyframes pulse-red {
                0% {
                    box-shadow: 0 0 0 0 rgba(229, 57, 53, 0.6);
                }

                70% {
                    box-shadow: 0 0 0 5px rgba(229, 57, 53, 0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(229, 57, 53, 0);
                }
            }

            .main-wrapper {
                display: flex;
                min-height: calc(100vh - 70px);
            }

            .sidebar-wrapper {
                width: 280px;
                background: #fff;
                border-right: 1px solid var(--rim-border);
                flex-shrink: 0;
            }

            .sidebar-menu {
                list-style: none;
                margin: 0;
                padding: 12px 0 24px 0;
            }

                .sidebar-menu li {
                    list-style: none;
                }

            .sidebar-link {
                display: flex;
                align-items: center;
                padding: 12px 20px;
                margin: 4px 16px;
                color: #2D2D2D;
                text-decoration: none;
                border-radius: 25px;
                transition: 0.2s;
            }

                .sidebar-link.active {
                    background-color: var(--rim-orange);
                    color: #fff !important;
                }

                .sidebar-link:hover:not(.active) {
                    background-color: var(--rim-orange-light);
                    color: var(--rim-orange);
                }

            .content-wrapper {
                flex-grow: 1;
                padding: 2rem;
                overflow-x: hidden;
            }

            /* --- 💡 ปุ่มโปรไฟล์แบบ Pill --- */
            .profile-btn-pill {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                padding: 6px 18px 6px 6px;
                border-radius: 50px;
                border: 1px solid var(--rim-border);
                background: #FFFFFF;
                text-decoration: none;
                transition: all 0.25s ease;
                color: var(--rim-text-main);
            }

                .profile-btn-pill:hover {
                    border-color: var(--rim-orange);
                    background: var(--rim-orange-light);
                    color: var(--rim-orange);
                }

                .profile-btn-pill::after {
                    display: none;
                }

            /* --- 💡 วงกลม Avatar สีส้ม --- */
            .profile-avatar-circle {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--rim-orange);
                color: #FFFFFF;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Kanit', sans-serif;
                font-weight: 600;
                font-size: 1.1rem;
            }

            /* --- ปรับแต่ง Dropdown เมนูใหม่ให้สวยงาม --- */
            .admin-user-menu {
                border-radius: 16px !important;
                border: 1px solid var(--rim-border);
                box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
                padding: 10px !important;
                min-width: 240px;
                margin-top: 15px !important;
            }

                .admin-user-menu .dropdown-item {
                    border-radius: 10px !important;
                    padding: 12px 15px !important;
                    transition: all 0.2s ease !important;
                }

                    .admin-user-menu .dropdown-item:hover {
                        background-color: var(--rim-orange-light) !important;
                        color: var(--rim-orange) !important;
                    }

            /* ========================================================
                           🌟 Custom CSS สำหรับ SweetAlert2 (Premium Notification)
                           ======================================================== */
            .premium-swal-popup {
                border-radius: 24px !important;
                padding: 2em 1.5em !important;
                box-shadow: 0 20px 50px rgba(0,0,0,0.1) !important;
                font-family: 'Kanit', sans-serif !important;
                border: 1px solid #EAEAEA !important;
            }

            .premium-swal-title {
                color: #2F2E2E !important;
                font-weight: 700 !important;
                font-size: 1.5rem !important;
                margin-bottom: 10px !important;
            }

            /* ปุ่มยืนยัน (สีเขียวพรีเมียม) */
            .premium-swal-confirm {
                border-radius: 50px !important;
                font-weight: 600 !important;
                font-size: 1rem !important;
                padding: 12px 28px !important;
                background: linear-gradient(135deg, #43C97A 0%, #2E7D32 100%) !important;
                box-shadow: 0 8px 20px rgba(67, 201, 122, 0.3) !important;
                transition: all 0.3s ease !important;
                color: white !important;
            }

                .premium-swal-confirm:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 25px rgba(67, 201, 122, 0.4) !important;
                }

            /* ปุ่มยกเลิก (สีแดงอ่อนๆ สไตล์ปุ่ม Ghost) */
            .premium-swal-cancel {
                border-radius: 50px !important;
                font-weight: 600 !important;
                font-size: 1rem !important;
                padding: 12px 28px !important;
                background-color: #FFF2EC !important;
                color: #D32F2F !important;
                border: 1.5px solid #FFDCDC !important;
                transition: all 0.3s ease !important;
            }

                .premium-swal-cancel:hover {
                    background-color: #D32F2F !important;
                    color: #FFFFFF !important;
                    border-color: #D32F2F !important;
                }

            /* ปุ่มสีส้มของแบรนด์ (สำหรับแจ้งเตือนทั่วไป) */
            .brand-swal-confirm {
                border-radius: 50px !important;
                font-weight: 600 !important;
                padding: 12px 30px !important;
                background: #FF9760 !important;
                box-shadow: 0 8px 20px rgba(255, 151, 96, 0.3) !important;
                color: white !important;
                border: none !important;
            }
    </style>

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
</head>
<body>
    <header class="admin-navbar">
        <a asp-controller="CustomerDashboard" asp-action="Index" class="admin-logo">KAREEM <span>WHEEL</span></a>

        <div class="d-flex align-items-center gap-4">

            <!-- 🔔 ไอคอนกระดิ่งแจ้งเตือน -->
            <a href="javascript:void(0);" class="cart-icon-link" title="การแจ้งเตือน" onclick="showNotificationPopup()">
                <i class="bi bi-bell-fill"></i>
                <span id="bellBadge" class="notification-badge d-none">!</span>
            </a>

            <!-- 🛒 ไอคอนตะกร้าสินค้า -->
            <a asp-controller="Cart" asp-action="Index" class="cart-icon-link">
                <i class="bi bi-cart-fill"></i>
                <span id="cartCountBadge" class="cart-badge @(ViewBag.CartCount is int cc && cc > 0 ? "" : "d-none")">@(ViewBag.CartCount ?? 0)</span>
            </a>

            <!-- Dropdown โปรไฟล์ -->
            <div class="dropdown">
                <a href="#" class="profile-btn-pill fw-bold dropdown-toggle" id="customerUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="profile-avatar-circle">@avatarInitial</span>
                    <span>@customerName</span>
                    <i class="bi bi-chevron-down ms-1" style="font-size: 0.8rem; color: #8A8A8A;"></i>
                </a>

                <ul class="dropdown-menu dropdown-menu-end admin-user-menu" aria-labelledby="customerUserDropdown">
                    <li>
                        <a asp-controller="Customer" asp-action="Profile" class="dropdown-item d-flex align-items-center">
                            <div class="me-3 shadow-sm" style="width:38px; height:38px; background:var(--rim-orange-light); color:var(--rim-orange); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size: 0.95rem; color: var(--rim-text-main);">ข้อมูลส่วนตัว</div>
                                <div class="text-muted" style="font-size: 0.75rem;">จัดการโปรไฟล์ของคุณ</div>
                            </div>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-2"></li>
                    <li>
                        <a asp-controller="Account" asp-action="Logout" class="dropdown-item text-danger d-flex align-items-center fw-bold">
                            <i class="bi bi-box-arrow-right me-3 fs-5"></i> ออกจากระบบ
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </header>

    <div class="main-wrapper">
        <div class="sidebar-wrapper">
            <div class="p-4 border-bottom d-flex align-items-center">
                <div class="me-3" style="width:45px; height:45px; background:var(--rim-orange); color:white; border-radius:12px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-person-fill"></i></div>
                <div><h6 class="m-0 fw-bold">ลูกค้า</h6><small class="text-muted">ยินดีต้อนรับเข้าสู่ระบบ</small></div>
            </div>
            <ul class="sidebar-menu flex-grow-1">
                <li><a asp-controller="CustomerDashboard" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CustomerDashboard" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"><i class="bi bi-grid-fill me-3"></i> สั่งซื้อสินค้า</a></li>
                <li><a asp-controller="Appointment" asp-action="Create" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Appointment" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")"><i class="bi bi-calendar-check-fill me-3"></i> นัดหมายรับบริการ</a></li>
                <li><a asp-controller="Appointment" asp-action="History" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Appointment" && ViewContext.RouteData.Values["Action"]?.ToString() == "History" ? "active" : "")"><i class="bi bi-clock-history me-3"></i> ประวัติการนัดหมาย</a></li>
                <li><a asp-controller="Order" asp-action="History" class="sidebar-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" && ViewContext.RouteData.Values["Action"]?.ToString() == "History" ? "active" : "")"><i class="bi bi-truck me-3"></i> ประวัติการสั่งซื้อ</a></li>
                <li><a asp-controller="CustomerDashboard" asp-action="BestSellers" class="sidebar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "BestSellers" ? "active" : "")"><i class="bi bi-fire me-3"></i> สินค้าขายดี</a></li>

            </ul>
        </div>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>

    <!-- ฟอร์มซ่อนสำหรับยืนยัน/ยกเลิกคิว (ต้องเป็น POST + antiforgery token) -->
    <form id="appointmentActionForm" method="post" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="appointmentActionId" value="" />
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- ดึง SweetAlert2 มาไว้ที่ส่วนกลาง เพื่อให้ใช้ได้ทุกหน้า -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function submitAppointmentAction(action, id) {
            var form = document.getElementById('appointmentActionForm');
            document.getElementById('appointmentActionId').value = id;
            form.action = '/CustomerDashboard/' + action;
            form.submit();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- 🌟 อัปเกรดสคริปต์แจ้งเตือนให้เป็น Premium Theme -->
    <script>
        let currentNotification = null;

        // 🔔 1. ทันทีที่โหลดหน้าเว็บ ให้วิ่งไปเช็คว่ามีแจ้งเตือนค้างอยู่ไหม
        $(document).ready(function () {
        fetchNotification();
        });

        // ฟังก์ชันดึงข้อมูลจาก Controller
        function fetchNotification() {
        $.get('/CustomerDashboard/CheckNotification', function (data) {
        if (data && data.hasNotification) {
        currentNotification = data;
        $('#bellBadge').removeClass('d-none'); // โชว์จุดแดงกระพริบ
        } else {
        currentNotification = null;
        $('#bellBadge').addClass('d-none'); // ซ่อนจุดแดง
        }
        });
        }

        // 🔔 2. ฟังก์ชันเมื่อลูกค้ากดคลิกที่ไอคอน "กระดิ่ง"
        function showNotificationPopup() {
        if (typeof Swal === 'undefined') return;

        if (currentNotification) {
        // 🌟 สร้าง HTML Card สำหรับแสดงรายละเอียดคิว
        const appointmentCard = `
        <div style="background: #F9FAFB; border: 1px solid #EAEAEA; border-radius: 16px; padding: 24px; margin: 15px 0; text-align: left; box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);">
        <div style="margin-bottom: 14px; font-size: 1.15rem; color: #2F2E2E; border-bottom: 1px dashed #D1D5DB; padding-bottom: 12px;">
        <i class="bi bi-tools" style="color: #FF9760; margin-right: 10px;"></i><b style="font-family: 'Montserrat', 'Kanit', sans-serif;">${currentNotification.serviceName}</b>
        </div>
        <div style="color: #8A8A8A; font-size: 1rem; margin-bottom: 8px;">
        <i class="bi bi-calendar-event" style="margin-right: 10px; color: #8A8A8A;"></i>วันที่: <b style="color: #2F2E2E;">${currentNotification.appDate}</b>
        </div>
        <div style="color: #8A8A8A; font-size: 1rem;">
        <i class="bi bi-clock" style="margin-right: 10px; color: #8A8A8A;"></i>เวลา: <b style="color: #2F2E2E;">${currentNotification.appTime} น.</b>
        </div>
        </div>
        <div style="color: #D32F2F; font-weight: 500; font-size: 0.95rem; margin-top: 20px;">
        * คุณยังสะดวกเข้ารับบริการตามวันและเวลาดังกล่าวหรือไม่?
        </div>
        `;

        Swal.fire({
        title: 'ยืนยันคิวของคุณ',
        html: appointmentCard,
        icon: 'question',
        iconColor: '#FF9760',
        showCancelButton: true,
        showCloseButton: true,
        confirmButtonText: '<i class="bi bi-check-circle-fill me-1"></i> สะดวก, ไปแน่นอน',
        cancelButtonText: '<i class="bi bi-x-circle-fill me-1"></i> ไม่สะดวก, ขอยกเลิก',
        reverseButtons: true, // สลับให้ปุ่มยืนยันอยู่ด้านขวา
        customClass: {
        popup: 'premium-swal-popup',
        title: 'premium-swal-title',
        confirmButton: 'premium-swal-confirm',
        cancelButton: 'premium-swal-cancel'
        }
        }).then((result) => {
        if (result.isConfirmed) {
        // กดยืนยัน ส่งกลับไปหลังบ้าน
        Swal.fire({
        title: 'กำลังบันทึกข้อมูล...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
        });
        submitAppointmentAction('ConfirmAppointment', currentNotification.id);
        } else if (result.dismiss === Swal.DismissReason.cancel) {
        // กดยกเลิก ถามย้ำอีกรอบเพื่อความชัวร์ (สไตล์แจ้งเตือนสีแดง)
        Swal.fire({
        title: 'ยืนยันการยกเลิก?',
        html: '<span style="color:#8A8A8A;">หากยกเลิกแล้ว คุณจะต้องทำการจองคิวใหม่อีกครั้ง</span>',
        icon: 'warning',
        iconColor: '#D32F2F',
        showCancelButton: true,
        confirmButtonText: 'ใช่, ฉันต้องการยกเลิก',
        cancelButtonText: 'ปิดหน้าต่าง',
        reverseButtons: true,
        customClass: {
        popup: 'premium-swal-popup',
        title: 'premium-swal-title',
        confirmButton: 'premium-swal-cancel', // ใช้คลาสปุ่มแดงมาเป็นปุ่มยืนยันยกเลิก
        cancelButton: 'btn btn-light rounded-pill px-4 fw-bold text-muted border'
        }
        }).then((cancelResult) => {
        if (cancelResult.isConfirmed) {
        Swal.fire({
        title: 'กำลังยกเลิกคิว...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
        });
        submitAppointmentAction('CancelAppointment', currentNotification.id);
        }
        });
        }
        });
        } else {
        // ถ้ากดกระดิ่งตอนที่ไม่มีอะไรค้างอยู่
        Swal.fire({
        title: 'ไม่มีการแจ้งเตือน',
        text: 'คุณไม่มีคิวที่ต้องยืนยันในขณะนี้',
        icon: 'info',
        iconColor: '#FF9760',
        confirmButtonText: 'ตกลง',
        customClass: {
        popup: 'premium-swal-popup',
        title: 'premium-swal-title',
        confirmButton: 'brand-swal-confirm'
        }
        });
        }
        }
    </script>

    <partial name="_Alerts" />
</body>
</html>