@{
    Layout = null;
}
@using Microsoft.AspNetCore.Http
@{
    // ดึงชื่อพนักงานมาทำ Avatar
    var employeeName = Context.Session.GetString("Customer_Name") ?? "Staff";
    var avatarInitial = !string.IsNullOrEmpty(employeeName) ? employeeName.Substring(0, 1).ToUpper() : "S";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kareem Employee</title>

    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Montserrat:wght@500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            :root {
                --rim-orange: #FF9760;
                --rim-orange-hover: #f38349;
                --rim-orange-light: #FFF2EB;
                --rim-bg-light: #F9FAFB;
                --rim-card: #FFFFFF;
                --rim-text-main: #2D2D2D;
                --rim-text-muted: #7A7A7A;
                --rim-border: #EAEAEA;
            }

            body {
                background-color: var(--rim-bg-light);
                font-family: 'Kanit', sans-serif;
                color: var(--rim-text-main);
                margin: 0;
            }

            /* --- Navbar --- */
            .staff-navbar {
                background: #fff;
                height: 70px;
                border-bottom: 1px solid var(--rim-border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 1000;
            }

            .staff-logo {
                font-family: 'Montserrat', sans-serif;
                font-weight: 900;
                font-size: 1.5rem;
                color: #2D2D2D;
                text-decoration: none;
            }

                .staff-logo span {
                    color: var(--rim-orange);
                }

            /* --- Sidebar & Layout --- */
            .main-wrapper {
                display: flex;
                min-height: calc(100vh - 70px);
            }

            .sidebar-wrapper {
                width: 280px;
                background-color: #FFFFFF;
                border-right: 1px solid var(--rim-border);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
            }

            .sidebar-header {
                padding: 24px;
                border-bottom: 1px solid var(--rim-border);
            }

            .brand-icon {
                width: 45px;
                height: 45px;
                background-color: var(--rim-orange);
                color: white;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                box-shadow: 0 4px 10px rgba(255, 151, 96, 0.3);
            }

            .sidebar-menu {
                padding: 20px 0;
                list-style: none;
                margin: 0;
            }

            .sidebar-item {
                margin: 4px 16px;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                padding: 12px 20px;
                color: var(--rim-text-main);
                text-decoration: none;
                border-radius: 25px;
                font-size: 0.95rem;
                transition: all 0.2s ease;
            }

                .sidebar-link.active {
                    background-color: var(--rim-orange);
                    color: #FFFFFF !important;
                    font-weight: 500;
                }

                .sidebar-link:hover:not(.active) {
                    background-color: var(--rim-orange-light);
                    color: var(--rim-orange);
                }

                .sidebar-link i {
                    font-size: 1.2rem;
                    margin-right: 12px;
                    width: 24px;
                    text-align: center;
                }

            .content-wrapper {
                flex-grow: 1;
                padding: 2rem;
                overflow-x: hidden;
            }

            /* --- Profile Dropdown (แบบแคปซูล) --- */
            .profile-btn-pill {
                display: inline-flex;
                align-items: center;
                gap: 12px;
                padding: 6px 18px 6px 6px;
                border-radius: 50px;
                border: 1px solid var(--rim-border);
                background: #FFFFFF;
                text-decoration: none;
                transition: all 0.25s ease;
                color: var(--rim-text-main);
            }

                .profile-btn-pill:hover {
                    border-color: var(--rim-orange);
                    background: var(--rim-orange-light);
                    color: var(--rim-orange);
                }

                .profile-btn-pill::after {
                    display: none;
                }

            .profile-avatar-circle {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--rim-orange);
                color: #FFFFFF;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Kanit', sans-serif;
                font-weight: 600;
                font-size: 1.1rem;
            }

            .staff-user-menu {
                border-radius: 16px !important;
                border: 1px solid var(--rim-border);
                box-shadow: 0 10px 30px rgba(0,0,0,0.08) !important;
                padding: 10px !important;
                min-width: 240px;
                margin-top: 15px !important;
            }

                .staff-user-menu .dropdown-item {
                    border-radius: 10px !important;
                    padding: 12px 15px !important;
                    transition: all 0.2s ease !important;
                }

                    .staff-user-menu .dropdown-item:hover {
                        background-color: var(--rim-orange-light) !important;
                        color: var(--rim-orange) !important;
                    }
    </style>

    @if (IsSectionDefined("Styles"))
    {
        @RenderSection("Styles", required: false)
    }
</head>
<body>
    <header class="staff-navbar">
        <a asp-controller="Home" asp-action="Index" class="staff-logo">KAREEM <span>WHEEL</span></a>

        <div class="d-flex align-items-center gap-4">
            <div class="dropdown">
                <a href="#" class="profile-btn-pill fw-bold dropdown-toggle" id="staffUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="profile-avatar-circle">@avatarInitial</span>
                    <span>@employeeName</span>
                    <i class="bi bi-chevron-down ms-1" style="font-size: 0.8rem; color: #8A8A8A;"></i>
                </a>

                <ul class="dropdown-menu dropdown-menu-end staff-user-menu" aria-labelledby="staffUserDropdown">
                    <li>
                        <a asp-controller="Customer" asp-action="Profile" class="dropdown-item d-flex align-items-center">
                            <div class="me-3 shadow-sm" style="width:38px; height:38px; background:var(--rim-orange-light); color:var(--rim-orange); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.2rem;">
                                <i class="bi bi-person-badge"></i>
                            </div>
                            <div>
                                <div class="fw-bold" style="font-size: 0.95rem; color: var(--rim-text-main);">ข้อมูลส่วนตัว</div>
                                <div class="text-muted" style="font-size: 0.75rem;">จัดการโปรไฟล์ของคุณ</div>
                            </div>
                        </a>
                    </li>
                    <li><hr class="dropdown-divider my-2"></li>
                    <li>
                        <a asp-controller="Account" asp-action="Logout" class="dropdown-item text-danger d-flex align-items-center fw-bold">
                            <i class="bi bi-box-arrow-right me-3 fs-5"></i> ออกจากระบบ
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="main-wrapper">
        <div class="sidebar-wrapper d-none d-md-flex">
            <div class="sidebar-header d-flex align-items-center gap-3">
                <div class="brand-icon">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h5 class="m-0 fw-bold" style="color: var(--rim-text-main);">STAFF PANEL</h5>
            </div>
            <ul class="sidebar-menu p-0 flex-grow-1">
                <li class="sidebar-item">
                    <a asp-controller="EmployeeDashboard" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i> ภาพรวมงานของฉัน
                    </a>
                </li>

                <!-- 🌟 เพิ่มเมนูตารางงานรวมตรงนี้ -->
                <li class="sidebar-item">
                    <a asp-controller="EmployeeDashboard" asp-action="Schedule" class="sidebar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Schedule" ? "active" : "")">
                        <i class="bi bi-kanban"></i> ตารางงานรวม
                    </a>
                </li>

                <li class="sidebar-item">
                    <a asp-controller="EmployeeDashboard" asp-action="SpareParts" class="sidebar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "SpareParts" ? "active" : "")">
                        <i class="bi bi-gear-wide-connected"></i> เบิกอะไหล่
                    </a>
                </li>
            </ul>
        </div>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_Alerts" />
</body>
</html>