@using Microsoft.AspNetCore.Http
@{
    var role = Context.Session.GetInt32("Role");
    var cname = Context.Session.GetString("Customer_Name");
    var cartCount = Context.Session.GetInt32("CartCount") ?? 0;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kareem Wheel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Kanit:wght@300;400;500;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --primary: #FF9760;
                --primary-hover: #E88655;
                --primary-light: #FFF2EB;
                --dark: #1E1E1E;
                --border: #EAEAEA;
                --light-bg: #F9FAFB;
            }

            body {
                font-size: 16px;
                line-height: 1.6;
                font-family: 'Kanit', sans-serif;
                font-weight: 400;
                background-color: var(--light-bg);
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                color: var(--dark);
            }

            .fw-900 {
                font-family: 'Montserrat', sans-serif;
                font-weight: 900 !important;
            }

            .navbar-rims {
                background: #FFFFFF;
                border-bottom: 1px solid var(--border);
                padding-top: 15px;
                padding-bottom: 15px;
            }

            .navbar-brand {
                font-family: 'Montserrat', sans-serif;
                font-size: 1.75rem;
                text-transform: uppercase;
                letter-spacing: -1px;
            }

            /* สไตล์สำหรับเมนูหลัก */
            .nav-link {
                font-family: 'Kanit', sans-serif;
                font-weight: 500;
                color: var(--dark);
                font-size: 1rem;
                position: relative;
                padding: 8px 12px !important;
                transition: color 0.3s ease;
            }

                .nav-link:hover {
                    color: var(--primary);
                }

                /* ขีดเส้นใต้ตอน Hover เมนู */
                .nav-link::after {
                    content: '';
                    position: absolute;
                    width: 0;
                    height: 2px;
                    bottom: 0;
                    left: 50%;
                    background-color: var(--primary);
                    transition: all 0.3s ease;
                    transform: translateX(-50%);
                }

                .nav-link:hover::after {
                    width: 80%;
                }

            /* สไตล์ปุ่ม เข้าสู่ระบบ (ขอบจาง) */
            .btn-login-outline {
                font-family: 'Kanit', sans-serif;
                color: var(--dark) !important;
                font-weight: 500;
                text-decoration: none;
                padding: 8px 20px;
                border-radius: 50px;
                border: 1.5px solid var(--border);
                background-color: #FFFFFF;
                transition: all 0.3s ease;
                font-size: 1rem;
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .btn-login-outline:hover {
                    border-color: var(--primary);
                    color: var(--primary) !important;
                    background-color: var(--primary-light);
                }

            /* สไตล์ปุ่ม สมัครสมาชิก (ทึบสีส้ม) */
            .btn-register-solid {
                font-family: 'Kanit', sans-serif;
                color: #FFFFFF !important;
                font-weight: 500;
                text-decoration: none;
                padding: 8px 24px;
                border-radius: 50px;
                border: 1.5px solid var(--primary);
                background-color: var(--primary);
                transition: all 0.3s ease;
                font-size: 1rem;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                box-shadow: 0 4px 10px rgba(255, 151, 96, 0.2);
            }

                .btn-register-solid:hover {
                    background-color: var(--primary-hover);
                    border-color: var(--primary-hover);
                    transform: translateY(-2px);
                    box-shadow: 0 6px 14px rgba(255, 151, 96, 0.35);
                }

            .cart-btn {
                color: var(--dark);
                font-size: 1.5rem;
                transition: color 0.3s ease;
                position: relative;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .cart-btn:hover {
                    color: var(--primary);
                }

            .page-body {
                padding-top: 100px;
                padding-bottom: 40px;
                flex: 1 0 auto;
            }

            .footer-custom {
                background-color: #FFFFFF;
                border-top: 1px solid var(--border);
                padding: 20px 0;
                margin-top: auto;
            }

            .swal2-popup {
                font-family: 'Kanit', sans-serif !important;
            }

            /* ===== Profile Dropdown ===== */
            .profile-btn {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                padding: 6px 18px 6px 6px;
                border-radius: 50px;
                border: 1px solid var(--border);
                background: #FFFFFF;
                text-decoration: none;
                transition: all 0.25s ease;
            }

                .profile-btn:hover {
                    border-color: var(--primary);
                    background: var(--primary-light);
                }

            .profile-avatar {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: var(--primary);
                color: #FFFFFF;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Montserrat', sans-serif;
                font-weight: 700;
                font-size: 1rem;
                flex-shrink: 0;
            }

            .profile-name {
                font-family: 'Montserrat', sans-serif;
                font-weight: 700;
                color: var(--dark);
                font-size: 0.95rem;
            }

            .profile-btn .bi-chevron-down {
                font-size: 0.75rem;
                color: var(--dark);
                transition: transform 0.25s ease;
            }

            .profile-btn[aria-expanded="true"] .bi-chevron-down {
                transform: rotate(180deg);
            }

            .profile-menu {
                border-radius: 14px;
                padding: 8px;
                min-width: 210px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            }

                .profile-menu .dropdown-item {
                    border-radius: 8px;
                    font-family: 'Kanit', sans-serif;
                    font-weight: 400;
                    display: flex;
                    align-items: center;
                    gap: 10px;
                    padding: 10px 12px;
                }

                    .profile-menu .dropdown-item:hover {
                        background-color: var(--primary-light);
                        color: var(--primary);
                    }

                    .profile-menu .dropdown-item.text-danger:hover {
                        background-color: #FFF0F0;
                    }

                    .profile-menu .dropdown-item i {
                        font-size: 1.05rem;
                    }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xl navbar-light navbar-rims fixed-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-900" asp-controller="Home" asp-action="Index">
                    KAREEM <span style="color: var(--primary);">WHEEL</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <!-- เมนูหลักอยู่กึ่งกลาง -->
                    <ul class="navbar-nav mx-auto mb-2 mb-xl-0 gap-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">หน้าแรก</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">ดูสินค้าทั้งหมด</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">เกี่ยวกับเรา</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">ติดต่อเรา</a>
                        </li>
                    </ul>

                    <div class="navbar-actions d-flex align-items-center gap-3 mt-3 mt-xl-0">

                        @if (role == 1)
                        {
                            <a asp-controller="Cart" asp-action="Index" class="cart-btn me-2 position-relative">
                                <i class="bi bi-cart"></i>
                                <span id="cartCountBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger @(cartCount == 0 ? "d-none" : "")" style="font-size: 0.75rem; padding: 0.35em 0.6em; font-family: 'Montserrat', sans-serif;">
                                    @cartCount
                                </span>
                            </a>
                        }

                        @if (cname != null)
                        {
                            <div class="dropdown">
                                <a href="#" class="profile-btn" data-bs-toggle="dropdown">
                                    <span class="profile-avatar">@cname.Substring(0, 1).ToUpper()</span>
                                    <span class="profile-name">@cname</span>
                                    <i class="bi bi-chevron-down"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end profile-menu border-0 mt-2">
                                    <li><a class="dropdown-item" asp-controller="Customer" asp-action="Profile"><i class="bi bi-person-badge"></i> ตั้งค่าส่วนตัว</a></li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right"></i> ออกจากระบบ</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn-login-outline">
                                เข้าสู่ระบบ
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn-register-solid">
                                สมัครสมาชิก
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="page-body">
        @RenderBody()
    </main>

    <footer class="footer-custom">
        <div class="container-fluid px-4 text-center text-secondary" style="font-size: 0.875rem;">
            &copy; @DateTime.Now.Year - <span class="fw-bold" style="font-family: 'Montserrat', sans-serif;">KAREEM WHEEL</span>. All rights reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // SweetAlert2 Helper Function
        function confirmAction(title, text, confirmCallback) {
        Swal.fire({
        title: title,
        text: text,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#FF9760',
        cancelButtonColor: '#d33',
        confirmButtonText: 'ตกลง',
        cancelButtonText: 'ยกเลิก',
        customClass: {
        confirmButton: 'fw-bold',
        cancelButton: 'fw-bold'
        }
        }).then((result) => {
        if (result.isConfirmed) {
        confirmCallback();
        }
        });
        }

        // 🔔 ระบบดักจับกล่องแจ้งเตือนอัตโนมัติจากฝั่ง Controller
        $(document).ready(function () {
        // 1. ตรวจสอบและแสดงข้อความล็อกอิน/ทำงานสำเร็จ
        var successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"] as string ?? ""));
        if (successMessage && successMessage.trim() !== '') {
        Swal.fire({
        title: 'สำเร็จ!',
        text: successMessage,
        icon: 'success',
        confirmButtonColor: '#FF9760',
        confirmButtonText: 'ตกลง'
        });
        }

        // 2. ตรวจสอบและแสดงข้อความผิดพลาด
        var errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"] as string ?? ""));
        if (errorMessage && errorMessage.trim() !== '') {
        Swal.fire({
        title: 'เกิดข้อผิดพลาด',
        text: errorMessage,
        icon: 'error',
        confirmButtonColor: '#FF9760',
        confirmButtonText: 'ตกลง'
        });
        }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_Alerts" />
</body>
</html>