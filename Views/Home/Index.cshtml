<script>
    // สลับแบนเนอร์หน้าแรกอัตโนมัติ (ทำงานเมื่อเจ้าของร้านเปิดใช้งานมากกว่า 1 รูป)
    (function () {
        var slides = document.querySelectorAll('.hero-slide');
        var dots = document.querySelectorAll('.hero-dot');
        if (slides.length < 2) return;

        var current = 0;
        var timer = null;

        function show(i) {
            slides[current].classList.remove('on');
            if (dots[current]) dots[current].classList.remove('on');

            current = (i + slides.length) % slides.length;

            slides[current].classList.add('on');
            if (dots[current]) dots[current].classList.add('on');
        }

        var DELAY = 3000; // สลับภาพทุก 3 วินาที

        function stop() {
            if (timer) { clearInterval(timer); timer = null; }
        }

        function start() {
            stop(); // กันตั้งเวลาซ้อนกันหลายตัว
            timer = setInterval(function () { show(current + 1); }, DELAY);
        }

        // กดจุดเพื่อเลือกภาพเอง แล้วเริ่มจับเวลาใหม่
        dots.forEach(function (d) {
            d.addEventListener('click', function () {
                show(parseInt(this.dataset.go, 10));
                start();
            });
        });

        // เบราว์เซอร์หน่วงเวลาเมื่อสลับไปแท็บอื่น กลับมาแล้วเริ่มนับใหม่ให้ตรง
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) { stop(); } else { start(); }
        });

        start();
    })();
</script>

