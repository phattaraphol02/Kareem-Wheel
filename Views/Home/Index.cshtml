@model IEnumerable<CS66_WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Premium Wheels - Rim Shop";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<!-- เปลี่ยนกลับมาใช้ฟอนต์หลักของแบรนด์ -->
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --orange: #FF9259;
        --orange-hover: #FF7B39;
        --orange-light: #FFF2EC;
        --bg-white: #FFFFFF;
        --bg-light: #F9FAFB;
        --text-dark: #2F2E2E;
        --text-muted: #8C8A89;
        --border: #EAEAEA;
        --border-strong: #D1D5DB;
        --success: #43C97A;
    }

    body {
        background: var(--bg-white);
        font-family: 'Kanit', sans-serif;
        color: var(--text-dark);
        font-size: 16px;
        line-height: 1.6;
    }

    .mono {
        font-family: 'Montserrat', sans-serif;
    }

    /* ── RING MOTIF (ลวดลายวงแหวนดุมล้อ) ── */
    .ring-field {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }

    .ring-svg {
        position: absolute;
        opacity: 0.8;
    }

    @@keyframes slow-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: no-preference) {
        .ring-spin {
            animation: slow-spin 90s linear infinite;
        }
    }

    /* ── HERO ── */
    .hero-section {
        background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-light) 100%);
        border-bottom: 1px solid var(--border);
        padding: 56px 0 0;
        overflow: hidden;
        position: relative;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--orange);
        margin-bottom: 22px;
        padding: 7px 14px 7px 10px;
        border: 1px solid rgba(255, 146, 89, 0.3);
        border-radius: 50px;
        background: var(--orange-light);
    }

        .hero-eyebrow i {
            font-size: 15px;
        }

    .hero-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 72px;
        line-height: 1.05;
        letter-spacing: -1.5px;
        text-transform: uppercase;
        color: var(--text-dark);
        margin-bottom: 26px;
    }

        .hero-title em {
            font-style: normal;
            color: var(--orange);
        }

    .hero-desc {
        color: var(--text-muted);
        font-size: 18px;
        font-weight: 300;
        line-height: 1.8;
        margin-bottom: 40px;
        max-width: 560px;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 56px;
    }

    .btn-primary-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--orange);
        color: #ffffff;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 17px 32px;
        border-radius: 50px;
        border: none;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(255, 146, 89, 0.2);
    }

        .btn-primary-cta:hover {
            background: var(--orange-hover);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(255, 146, 89, 0.35);
        }

    .btn-ghost-cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #ffffff;
        color: var(--text-dark);
        font-family: 'Kanit', sans-serif;
        font-weight: 500;
        font-size: 16px;
        letter-spacing: 0.5px;
        padding: 17px 28px;
        border-radius: 50px;
        border: 1.5px solid var(--border-strong);
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-ghost-cta:hover {
            border-color: var(--orange);
            color: var(--orange);
            background: var(--orange-light);
        }

    /* แถบสเปควิ่งแนวตั้ง */
    .spec-tape {
        display: flex;
        flex-direction: column;
        gap: 22px;
        padding: 28px 0;
        border-left: 1px solid var(--border-strong);
        padding-left: 24px;
    }

    .spec-tape-item .spec-val {
        font-family: 'Montserrat', sans-serif;
        font-size: 22px;
        font-weight: 800;
        color: var(--text-dark);
        display: block;
    }

    .spec-tape-item .spec-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 600;
    }

    .hero-visual {
        position: relative;
        height: 100%;
        min-height: 480px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    /* ── แก้ไขส่วนแสดงภาพให้เต็มจอและโค้งมน ── */
    .hero-shop-img-wrap {
        position: relative;
        z-index: 1;
        width: 100%; /* เปลี่ยนเป็น 100% ให้อยู่พอดีกรอบ */
        max-width: none;
        border-radius: 24px; /* โค้งมนทุกมุม */
        overflow: hidden;
        background: var(--bg-white);
        box-shadow: 0 20px 60px rgba(0,0,0,0.1);
        border: 8px solid #ffffff;
    }

        /* กรอบสัดส่วนคงที่ ทำให้แบนเนอร์ที่เจ้าของร้านอัปโหลดขนาดไม่เท่ากันแสดงผลเท่ากันเสมอ */
        .hero-shop-img-wrap {
            aspect-ratio: 16 / 10;
        }

    .hero-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.8s ease;
        pointer-events: none;
    }

        .hero-slide.on {
            opacity: 1;
            pointer-events: auto;
        }

        .hero-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    /* จุดเลือกแบนเนอร์ (แสดงเมื่อเปิดใช้งานมากกว่า 1 รูป) */
    .hero-dots {
        position: absolute;
        bottom: 22px;
        right: 24px;
        display: flex;
        gap: 8px;
        z-index: 3;
    }

    .hero-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: none;
        padding: 0;
        cursor: pointer;
        background: rgba(255,255,255,0.55);
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        transition: all 0.25s;
    }

        .hero-dot.on {
            background: var(--orange);
            width: 26px;
            border-radius: 6px;
        }

    .hero-shop-img-badge {
        position: absolute;
        bottom: 24px;
        left: 24px;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 2;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        backdrop-filter: blur(5px);
    }

        .hero-shop-img-badge i {
            color: var(--orange);
            font-size: 1.5rem;
        }

    .hero-shop-img-badge-text {
        font-family: 'Kanit', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-dark);
        line-height: 1.3;
    }

        .hero-shop-img-badge-text span {
            display: block;
            font-weight: 400;
            color: var(--text-muted);
            font-size: 12px;
        }

    /* ── FEATURES STRIP ── */
    .features-strip {
        background: var(--bg-white);
        border-bottom: 1px solid var(--border);
        padding: 0;
    }

    .features-inner {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .feat-item {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 38px 40px;
        border-right: 1px solid var(--border);
    }

        .feat-item:last-child {
            border-right: none;
        }

    .feat-icon {
        width: 52px;
        height: 52px;
        clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0% 50%);
        background: var(--orange-light);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .feat-icon i {
            font-size: 1.4rem;
            color: var(--orange);
        }

    .feat-title {
        font-family: 'Montserrat', sans-serif;
        font-size: 16px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-dark);
        margin: 0 0 4px;
    }

    .feat-sub {
        font-size: 14px;
        color: var(--text-muted);
        margin: 0;
        font-weight: 300;
        line-height: 1.5;
    }

    /* ── SECTION HEADER ── */
    .section-eyebrow {
        font-family: 'Kanit', sans-serif;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 2px;
        color: var(--orange);
        margin-bottom: 8px;
    }

    .section-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 40px;
        text-transform: uppercase;
        color: var(--text-dark);
        margin: 0;
        letter-spacing: -0.5px;
    }

    .view-all-link {
        font-family: 'Kanit', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: var(--orange);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-bottom: 1.5px solid var(--orange);
        padding-bottom: 2px;
        transition: 0.2s;
    }

        .view-all-link:hover {
            color: var(--orange-hover);
            border-color: var(--orange-hover);
        }

    /* ── PRODUCT CARDS ── */
    .prod-card {
        background: var(--bg-white);
        border-radius: 16px;
        border: 1px solid var(--border);
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

        .prod-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 146, 89, 0.4);
            box-shadow: 0 15px 35px rgba(255, 146, 89, 0.1);
        }

    .prod-img-wrap {
        background: repeating-radial-gradient(circle at 50% 50%, transparent 0, transparent 24px, #F4F4F4 25px, #F4F4F4 26px), #FAF8F7;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .prod-img-wrap img {
            max-height: 190px;
            max-width: 80%;
            object-fit: contain;
            transition: transform 0.4s ease;
            position: relative;
            z-index: 1;
        }

    .img-disabled {
        opacity: 0.35;
        filter: grayscale(100%);
    }

    .prod-card:hover .prod-img-wrap img:not(.img-disabled) {
        transform: scale(1.08) rotate(8deg);
    }

    .prod-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 6px 12px 6px 10px;
        border-radius: 20px;
        background: var(--bg-white);
        border: 1px solid var(--border);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        z-index: 2;
    }

        .prod-badge::before {
            content: '';
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .badge-new {
        color: var(--text-dark);
    }

        .badge-new::before {
            background: var(--orange);
            box-shadow: 0 0 0 3px var(--orange-light);
        }

    .badge-hot {
        color: var(--text-dark);
    }

        .badge-hot::before {
            background: var(--success);
            box-shadow: 0 0 0 3px rgba(67,201,122,0.16);
        }

    .badge-out {
        color: var(--text-muted);
    }

        .badge-out::before {
            background: var(--text-muted);
        }

    .prod-body {
        padding: 22px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .prod-brand {
        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .prod-name {
        font-family: 'Kanit', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: var(--text-dark);
        line-height: 1.4;
        margin-bottom: 18px;
        flex-grow: 1;
    }

    .prod-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        border-top: 1px dashed var(--border-strong);
    }

    .prod-price {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 21px;
        color: var(--orange);
    }

    .price-disabled {
        color: var(--text-muted) !important;
    }

    .btn-details {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Kanit', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: var(--orange);
        background: var(--orange-light);
        border: none;
        padding: 8px 16px;
        border-radius: 50px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .btn-details:hover {
            background: var(--orange);
            color: white;
        }

    .btn-out-of-stock {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Kanit', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: var(--text-muted);
        background: #F1F3F5;
        border: none;
        padding: 8px 16px;
        border-radius: 50px;
        cursor: not-allowed;
    }

    /* ── BRANDS STRIP ── */
    .brands-section {
        background: var(--bg-white);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 50px 0;
    }

    .brand-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 30px;
        text-align: center;
    }

    .brands-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0;
        flex-wrap: wrap;
    }

    .brand-pill {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 20px;
        color: #C0C0C0;
        padding: 14px 46px;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all 0.2s;
        border-right: 1px solid var(--border);
        cursor: default;
    }

        .brand-pill:last-child {
            border-right: none;
        }

        .brand-pill:hover {
            color: var(--orange);
            background: var(--orange-light);
        }

    /* ── FOOTER ── */
    .wm-footer {
        background-color: var(--bg-light);
        color: var(--text-dark);
        padding: 76px 0 36px;
        margin-top: auto;
        font-family: 'Kanit', sans-serif;
        border-top: 1px solid var(--border);
    }

    .wm-footer-grid {
        display: grid;
        grid-template-columns: 2.2fr 1fr 1.2fr 2fr;
        gap: 48px;
    }

    .wm-footer-logo {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .wm-footer-logo-box {
        width: 46px;
        height: 46px;
        clip-path: polygon(25% 3%, 75% 3%, 100% 50%, 75% 97%, 25% 97%, 0% 50%);
        background: var(--orange);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #ffffff;
        font-size: 18px;
        font-family: 'Montserrat', sans-serif;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(255, 146, 89, 0.3);
    }

    .wm-footer-logo-name {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 20px;
        color: var(--text-dark);
        text-transform: uppercase;
        line-height: 1.2;
    }

    .wm-footer-logo-sub {
        font-size: 12px;
        color: var(--text-muted);
        letter-spacing: 1px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
    }

    .wm-footer-desc {
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.8;
        margin-bottom: 24px;
        font-weight: 300;
    }

    .wm-footer-socials {
        display: flex;
        gap: 8px;
    }

    .wm-footer-social-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: var(--bg-white);
        border: 1px solid var(--border-strong);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-dark);
        font-size: 15px;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

        .wm-footer-social-btn:hover {
            background: var(--orange);
            border-color: var(--orange);
            color: white;
        }

    .wm-footer-col-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 16px;
        text-transform: uppercase;
        color: var(--text-dark);
        margin-bottom: 20px;
    }

    .wm-footer-links {
        display: flex;
        flex-direction: column;
        gap: 12px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .wm-footer-links a {
            color: var(--text-muted);
            font-size: 14px;
            text-decoration: none;
            transition: color 0.2s;
            font-weight: 400;
        }

            .wm-footer-links a:hover {
                color: var(--orange);
            }

    .wm-footer-contact-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .wm-footer-contact-item {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .wm-footer-contact-icon {
        color: var(--orange);
        font-size: 18px;
        margin-top: 2px;
        flex-shrink: 0;
    }

    .wm-footer-contact-label {
        font-weight: 600;
        font-size: 13px;
        color: var(--text-dark);
        margin-bottom: 4px;
        font-family: 'Kanit', sans-serif;
    }

    .wm-footer-contact-detail {
        color: var(--text-muted);
        font-size: 14px;
        line-height: 1.6;
        font-weight: 300;
    }

    .wm-footer-bottom {
        border-top: 1px solid var(--border);
        margin-top: 44px;
        padding-top: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .wm-footer-copy {
        color: var(--text-muted);
        font-size: 13px;
    }

    .wm-footer-legal {
        display: flex;
        gap: 24px;
    }

        .wm-footer-legal a {
            color: var(--text-muted);
            font-size: 13px;
            text-decoration: none;
            transition: color 0.2s;
        }

            .wm-footer-legal a:hover {
                color: var(--orange);
            }

    /* ── RESPONSIVE ── */
    @@media (max-width: 1400px) {
        .hero-title {
            font-size: 60px;
        }
    }

    @@media (max-width: 1200px) {
        .hero-title {
            font-size: 48px;
        }

        .hero-visual {
            min-height: auto;
        }
    }

    @@media (max-width: 992px) {
        .wm-footer-grid {
            grid-template-columns: 1fr 1fr;
        }

        .features-inner {
            grid-template-columns: repeat(2, 1fr);
        }

        .feat-item {
            border-bottom: 1px solid var(--border);
        }

            .feat-item:nth-child(2), .feat-item:nth-child(4) {
                border-right: none;
            }

            .feat-item:nth-child(3), .feat-item:nth-child(4) {
                border-bottom: none;
            }
    }

    @@media (max-width: 768px) {
        .hero-title {
            font-size: 40px;
        }

        .hero-section {
            padding: 40px 0 0;
        }

        .spec-tape {
            flex-direction: row;
            flex-wrap: wrap;
            border-left: none;
            border-top: 1px solid var(--border);
            padding-left: 0;
            padding-top: 20px;
            gap: 24px;
        }
    }

    @@media (max-width: 576px) {
        .wm-footer-grid {
            grid-template-columns: 1fr;
        }

        .features-inner {
            grid-template-columns: 1fr;
        }

        .feat-item {
            border-right: none !important;
            border-bottom: 1px solid var(--border) !important;
        }

            .feat-item:last-child {
                border-bottom: none !important;
            }

        .brand-pill {
            border-right: none;
            border-bottom: 1px solid var(--border);
            width: 50%;
            text-align: center;
        }
    }
</style>

