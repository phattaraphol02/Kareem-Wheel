@model List<CS66_WebApplication1.Models.Expense>
@using CS66_WebApplication1.Models

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "รายรับ-รายจ่าย";

    string period = ViewBag.Period as string ?? "month";
    var categories = ViewBag.Categories as string[] ?? Expense.Categories;

    decimal totalIncome = ViewBag.TotalIncome ?? 0m;
    decimal totalExpense = ViewBag.TotalExpense ?? 0m;
    decimal netProfit = ViewBag.NetProfit ?? 0m;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;900&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB;
        --rim-border: #EAEAEA;
        --rim-muted: #7A7A7A;
    }

    body { background: #F9FAFB; font-family: 'Kanit', sans-serif; }

    .page-header-rim {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        padding: 30px 35px; border-radius: 16px; margin-bottom: 25px;
        border: 1px solid var(--rim-border); display: flex; align-items: center; gap: 15px;
    }

    .header-icon {
        width: 50px; height: 50px; background: var(--rim-orange); color: white;
        border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; box-shadow: 0 4px 15px rgba(255,151,96,0.3);
    }

    .btn-rim-filter {
        border: 1px solid var(--rim-border); background: #FFF; color: var(--rim-muted);
        font-size: 0.85rem; font-weight: 500; padding: 8px 22px; border-radius: 30px;
        transition: all 0.25s; text-decoration: none; display: inline-block;
    }

    .btn-rim-filter:hover, .btn-rim-filter.active {
        background: var(--rim-orange); color: white; border-color: var(--rim-orange);
        box-shadow: 0 4px 12px rgba(255,151,96,0.25);
    }

    .kpi-card {
        background: #FFF; border: 1px solid var(--rim-border); border-radius: 16px;
        padding: 24px; height: 100%; box-shadow: 0 6px 20px rgba(0,0,0,0.03);
    }

    .kpi-label { font-size: 0.82rem; color: var(--rim-muted); font-weight: 500; }

    .kpi-value {
        font-family: 'Montserrat', sans-serif; font-weight: 800;
        font-size: 1.75rem; line-height: 1.2; margin-top: 6px;
    }

    .kpi-sub { font-size: 0.78rem; color: var(--rim-muted); margin-top: 8px; }

    .income { color: #2E7D32; }
    .expense { color: #C62828; }
    .profit-pos { color: #2E7D32; }
    .profit-neg { color: #C62828; }

    .panel-card {
        background: #FFF; border: 1px solid var(--rim-border); border-radius: 16px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.03); overflow: hidden; margin-bottom: 25px;
    }

    .panel-head {
        padding: 16px 22px; border-bottom: 1px solid var(--rim-border);
        font-weight: 600; display: flex; align-items: center; gap: 8px;
    }

    .panel-body { padding: 22px; }

    .table thead th {
        background: #FAFAFA; padding: 14px 20px; border-bottom: 2px solid var(--rim-border);
        font-size: 0.8rem; font-weight: 600; color: #555; text-transform: uppercase;
    }

    .table tbody td {
        padding: 14px 20px; vertical-align: middle;
        border-bottom: 1px solid #F5F5F5; font-size: 0.9rem;
    }

    .cat-badge {
        background: var(--rim-orange-light); color: #E58856;
        padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600;
    }

    .form-label-sm { font-size: 0.82rem; font-weight: 600; color: var(--rim-muted); margin-bottom: 6px; }

    .form-control, .form-select {
        border: 1px solid var(--rim-border); border-radius: 10px;
        padding: 10px 14px; font-size: 0.9rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--rim-orange); box-shadow: 0 0 0 3px rgba(255,151,96,0.12);
    }

    .btn-save {
        background: var(--rim-orange); color: #fff; border: none; border-radius: 10px;
        padding: 11px 20px; font-weight: 600; width: 100%; transition: 0.2s;
    }

    .btn-save:hover { background: #f38349; color: #fff; }

    .btn-del {
        background: transparent; border: 1px solid #FFCDD2; color: #C62828;
        border-radius: 8px; padding: 5px 12px; font-size: 0.8rem; transition: 0.2s;
    }

    .btn-del:hover { background: #C62828; color: #fff; border-color: #C62828; }

    .empty-row { text-align: center; padding: 45px 20px; color: var(--rim-muted); }

    .bar-track { background: #F1F3F5; border-radius: 20px; height: 8px; overflow: hidden; }
    .bar-fill { background: var(--rim-orange); height: 100%; border-radius: 20px; }
</style>

<div class="container-fluid px-lg-5 py-4">

    <div class="page-header-rim">
        <div class="header-icon"><i class="bi bi-currency-exchange"></i></div>
        <div>
            <h2 class="fw-bold mb-1" style="font-family:'Montserrat',sans-serif;">รายรับ-<span style="color:var(--rim-orange)">รายจ่าย</span></h2>
            <p class="text-muted mb-0" style="font-size:0.9rem;">สรุปผลประกอบการ @ViewBag.PeriodLabel</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-3"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <!-- ปุ่มเลือกช่วงเวลา -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn-rim-filter @(period == "day" ? "active" : "")" asp-action="Index" asp-route-period="day">รายวัน</a>
        <a class="btn-rim-filter @(period == "month" ? "active" : "")" asp-action="Index" asp-route-period="month">รายเดือน</a>
        <a class="btn-rim-filter @(period == "year" ? "active" : "")" asp-action="Index" asp-route-period="year">รายปี</a>
    </div>

    <!-- KPI -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label"><i class="bi bi-arrow-down-circle-fill me-1 income"></i> รายรับรวม</div>
                <div class="kpi-value income">฿@totalIncome.ToString("N2")</div>
                <div class="kpi-sub">
                    ขายสินค้า ฿@(((decimal)(ViewBag.ProductIncome ?? 0m)).ToString("N0")) ·
                    ค่าบริการ ฿@(((decimal)(ViewBag.ServiceIncome ?? 0m)).ToString("N0"))
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label"><i class="bi bi-arrow-up-circle-fill me-1 expense"></i> รายจ่ายรวม</div>
                <div class="kpi-value expense">฿@totalExpense.ToString("N2")</div>
                <div class="kpi-sub">
                    ต้นทุนสินค้าเข้าร้าน ฿@(((decimal)(ViewBag.ProcurementCost ?? 0m)).ToString("N0")) ·
                    อื่นๆ ฿@(((decimal)(ViewBag.ManualExpense ?? 0m)).ToString("N0"))
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label"><i class="bi bi-graph-up-arrow me-1"></i> กำไรสุทธิ</div>
                <div class="kpi-value @(netProfit >= 0 ? "profit-pos" : "profit-neg")">฿@netProfit.ToString("N2")</div>
                <div class="kpi-sub">
                    @if (netProfit >= 0)
                    {
                        <span><i class="bi bi-emoji-smile me-1"></i>ร้านมีกำไรในช่วงนี้</span>
                    }
                    else
                    {
                        <span><i class="bi bi-exclamation-circle me-1"></i>รายจ่ายมากกว่ารายรับ</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- ฟอร์มบันทึกรายจ่าย -->
        <div class="col-lg-4">
            <div class="panel-card">
                <div class="panel-head"><i class="bi bi-plus-circle" style="color:var(--rim-orange);"></i> บันทึกรายจ่ายใหม่</div>
                <div class="panel-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="period" value="@period" />

                        <div class="mb-3">
                            <label class="form-label-sm d-block">รายการ</label>
                            <input type="text" name="Title" class="form-control" maxlength="200" required placeholder="เช่น ค่าไฟฟ้าเดือนนี้" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-sm d-block">หมวดหมู่</label>
                            <select name="Category" class="form-select" required>
                                @foreach (var c in categories)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-sm d-block">จำนวนเงิน (บาท)</label>
                            <input type="number" name="Amount" class="form-control" step="0.01" min="0.01" required placeholder="0.00" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-sm d-block">วันที่</label>
                            <input type="date" name="ExpenseDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-sm d-block">หมายเหตุ (ไม่บังคับ)</label>
                            <input type="text" name="Note" class="form-control" maxlength="255" />
                        </div>

                        <button type="submit" class="btn-save"><i class="bi bi-save me-1"></i> บันทึกรายจ่าย</button>
                    </form>
                </div>
            </div>

            <!-- สรุปตามหมวดหมู่ -->
            <div class="panel-card">
                <div class="panel-head"><i class="bi bi-pie-chart" style="color:var(--rim-orange);"></i> รายจ่ายแยกตามหมวด</div>
                <div class="panel-body">
                    @{
                        var byCat = ViewBag.ByCategory as List<Expense.CategoryTotal> ?? new List<Expense.CategoryTotal>();
                        decimal manualTotal = ViewBag.ManualExpense ?? 0m;
                    }
                    @if (byCat.Any())
                    {
                        foreach (var c in byCat)
                        {
                            int pct = manualTotal > 0 ? (int)(c.Total * 100 / manualTotal) : 0;
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1" style="font-size:0.85rem;">
                                    <span>@c.Category</span>
                                    <span class="fw-bold">฿@c.Total.ToString("N0")</span>
                                </div>
                                <div class="bar-track"><div class="bar-fill" style="width:@pct%;"></div></div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-0">ยังไม่มีรายจ่ายในช่วงเวลานี้</p>
                    }
                </div>
            </div>
        </div>

        <!-- ตารางรายจ่าย -->
        <div class="col-lg-8">
            <div class="panel-card">
                <div class="panel-head">
                    <i class="bi bi-list-ul" style="color:var(--rim-orange);"></i> รายการรายจ่าย @ViewBag.PeriodLabel
                    <span class="text-muted fw-normal ms-1" style="font-size:0.8rem;">(@Model.Count รายการ)</span>
                </div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>วันที่</th>
                                <th>รายการ</th>
                                <th>หมวดหมู่</th>
                                <th class="text-end">จำนวนเงิน</th>
                                <th class="text-center" style="width:90px;">จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                foreach (var e in Model)
                                {
                                    <tr>
                                        <td>@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            <div class="fw-bold">@e.Title</div>
                                            @if (!string.IsNullOrEmpty(e.Note))
                                            {
                                                <small class="text-muted">@e.Note</small>
                                            }
                                        </td>
                                        <td><span class="cat-badge">@e.Category</span></td>
                                        <td class="text-end fw-bold expense">฿@e.Amount.ToString("N2")</td>
                                        <td class="text-center">
                                            <form asp-action="Delete" method="post" onsubmit="return confirm('ลบรายจ่าย &quot;@e.Title&quot; ใช่หรือไม่?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@e.Expense_Id" />
                                                <input type="hidden" name="period" value="@period" />
                                                <button type="submit" class="btn-del"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="empty-row">
                                        <i class="bi bi-receipt-cutoff fs-1 d-block mb-2" style="color:#EAEAEA;"></i>
                                        <h6 class="fw-bold">ยังไม่มีรายจ่ายในช่วงนี้</h6>
                                        <p class="mb-0 small">บันทึกรายจ่ายแรกได้จากฟอร์มด้านซ้าย</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel-card">
                <div class="panel-head"><i class="bi bi-info-circle" style="color:var(--rim-orange);"></i> หมายเหตุการคำนวณ</div>
                <div class="panel-body" style="font-size:0.87rem; color:var(--rim-muted); line-height:1.9;">
                    <div><b class="income">รายรับ</b> = ยอดขายสินค้าที่ยืนยันการชำระเงินแล้ว + ค่าบริการของงานที่เสร็จสิ้นแล้ว</div>
                    <div><b class="expense">รายจ่าย</b> = ต้นทุนสินค้าเข้าร้าน (จากใบสั่งซื้อที่รับของแล้ว) + รายจ่ายที่บันทึกในหน้านี้</div>
                    <div><b>กำไรสุทธิ</b> = รายรับรวม − รายจ่ายรวม</div>
                </div>
            </div>
        </div>
    </div>
</div>
