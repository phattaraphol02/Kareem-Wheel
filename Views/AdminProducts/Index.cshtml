@model List<CS66_WebApplication1.Models.Product>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "ระบบจัดการคลังสินค้า";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB;
        --rim-bg-light: #F9FAFB;
        --rim-border: #EAEAEA;
    }

    body {
        background-color: var(--rim-bg-light);
        font-family: 'Kanit', sans-serif;
    }

    /* Header */
    .admin-header {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        padding: 35px 40px;
        border-left: 6px solid var(--rim-orange);
        border-radius: 16px;
        margin-bottom: 30px;
        border: 1px solid var(--rim-border);
    }

    .header-icon {
        background: var(--rim-orange);
        color: white;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        font-size: 1.5rem;
        box-shadow: 0 4px 15px rgba(255, 151, 96, 0.3);
    }

    /* Table Lux */
    .table-card {
        background: #FFFFFF;
        border: 1px solid var(--rim-border);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        overflow: hidden;
    }

    .table thead th {
        background: #FAFAFA;
        padding: 18px 25px;
        border-bottom: 2px solid var(--rim-border);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #555;
    }

    .table tbody td {
        padding: 20px 25px;
        vertical-align: middle;
        border-bottom: 1px solid #F8F9FA;
    }

    /* Actions */
    .btn-action-lux {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid var(--rim-border);
        background: #FFFFFF;
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-edit {
        color: #4A90E2;
    }

        .btn-edit:hover {
            background: #4A90E2;
            color: white;
            border-color: #4A90E2;
        }

    .btn-delete {
        color: #E05638;
        border: none;
    }

        .btn-delete:hover {
            background: #E05638;
            color: white;
        }

    .btn-toggle {
        color: #FF9760;
    }

        .btn-toggle:hover {
            background: var(--rim-orange);
            color: white;
            border-color: var(--rim-orange);
        }
</style>

<div class="container-fluid px-lg-5 py-4 animate__animated animate__fadeIn">

    <div class="admin-header shadow-sm d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <div class="header-icon me-4"><i class="bi bi-gear-wide-connected"></i></div>
            <div>
                <h2 class="fw-bold mb-1" style="font-family: 'Montserrat', sans-serif;">ระบบจัดการ<span style="color: var(--rim-orange);">คลังสินค้า</span></h2>
                <p class="mb-0 text-muted">ตรวจสอบสต็อก อัปเดตข้อมูล และจัดการรายละเอียดล้อแม็ก</p>
            </div>
        </div>
        <a class="btn btn-primary px-4 py-2 rounded-pill shadow-sm" style="background-color: var(--rim-orange); border: none;" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> เพิ่มสินค้าใหม่
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm mb-4 py-3 rounded-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">ข้อมูลสินค้า</th>
                        <th>ราคา (บาท)</th>
                        <th class="text-center">จำนวน</th>
                        <th class="text-center">สถานะ</th>
                        <th class="pe-4 text-center">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div style="width: 60px; height: 60px; background: #fafafa; border-radius: 12px; display: flex; align-items: center; justify-content: center; border: 1px solid #f0f0f0;" class="me-3">
                                        @if (!string.IsNullOrEmpty(item.ImageFileName))
                                        {
                                            <img src="/Products/@item.ImageFileName" style="max-width: 80%; max-height: 80%; object-fit: contain;">
                                        }
                                        else
                                        {
                                            <i class="bi bi-image text-muted fs-4"></i>
                                        }
                                    </div>
                                    <div class="fw-bold text-dark">@item.Product_Name</div>
                                </div>
                            </td>
                            <td class="fw-bold text-dark">฿@item.Price.ToString("N0")</td>

                            <td class="text-center">
                                @if (item.Quantity == 0)
                                {
                                    <span class="badge rounded-pill px-3 py-2" style="background: #FCE8E6; color: #C5221F; font-size: 0.8rem;">0 ชิ้น</span>
                                }
                                else if (item.Quantity < 5)
                                {
                                    <span class="badge rounded-pill px-3 py-2" style="background: #FFF3E0; color: #E65100; font-size: 0.8rem;">@item.Quantity ชิ้น</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2" style="background: #E6F4EA; color: #137333; font-size: 0.8rem;">@item.Quantity ชิ้น</span>
                                }
                            </td>

                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge rounded-pill px-3 py-2" style="background: #E6F4EA; color: #137333; font-size: 0.75rem;">
                                        <i class="bi bi-check-circle-fill me-1"></i> พร้อมจำหน่าย
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-2" style="background: #FCE8E6; color: #C5221F; font-size: 0.75rem;">
                                        <i class="bi bi-x-circle-fill me-1"></i> สินค้าหมด
                                    </span>
                                }
                            </td>

                            <td class="pe-4 text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a class="btn-action-lux btn-edit" asp-action="Edit" asp-route-id="@item.Product_Id" title="แก้ไข">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="ToggleStatus" asp-route-id="@item.Product_Id" method="post" class="d-inline" onsubmit="return confirm('ต้องการเปลี่ยนสถานะสินค้านี้ใช่หรือไม่?');">
                                        <button type="submit" class="btn-action-lux btn-toggle" title="สลับสถานะ">
                                            <i class="bi @(item.IsActive ? "bi-toggle-on" : "bi-toggle-off") fs-5"></i>
                                        </button>
                                    </form>

                                    <form asp-action="Delete" asp-route-id="@item.Product_Id" method="post" class="d-inline" onsubmit="return confirm('คุณแน่ใจหรือไม่ที่จะลบสินค้านี้?');">
                                        <button type="submit" class="btn-action-lux btn-delete" title="ลบ">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>