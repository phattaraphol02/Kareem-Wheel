@model ProductDto
@{
    ViewData["Title"] = "Asset Editor - Admin";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB; /* สีส้มพาสเทลสว่าง */
        --rim-orange-hover: #f38349;
        --rim-bg-light: #F9FAFB; /* พื้นหลังเว็บสีขาวสว่าง */
        --rim-card: #FFFFFF; /* พื้นหลังการ์ดขาวล้วน */
        --rim-text-main: #2D2D2D; /* สีตัวอักษรหลัก */
        --rim-text-muted: #7A7A7A; /* สีตัวอักษรรอง */
        --rim-border: #EAEAEA; /* สีเส้นขอบเทาอ่อน */
    }

    body {
        background-color: var(--rim-bg-light);
        font-family: 'Kanit', sans-serif;
        color: var(--rim-text-main);
    }

    /* Header Styling - ไล่เฉดสว่าง ขาว-ส้มพาสเทล ขอบซ้ายส้มเด่นชัด */
    .page-header-rim {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        color: var(--rim-text-main);
        padding: 35px 40px;
        border-left: 6px solid var(--rim-orange);
        border-radius: 12px;
        margin-bottom: 35px;
        border-top: 1px solid var(--rim-border);
        border-right: 1px solid var(--rim-border);
        border-bottom: 1px solid var(--rim-border);
    }

    /* Card Styling - ขอบมน นุ่มนวล คลีนแบบพรีเมียม */
    .main-edit-card {
        border: 1px solid var(--rim-border);
        border-radius: 12px;
        background: var(--rim-card);
        box-shadow: 0 8px 25px rgba(0,0,0,0.01);
    }

    /* Section Group Title Inside Card */
    .group-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--rim-text-main);
        margin-bottom: 22px;
        border-left: 4px solid var(--rim-orange);
        padding-left: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Form Elements - ปรับจากเหลี่ยมคมเป็นโค้งมนมนพรีเมียม */
    .form-control, .form-select {
        border: 1px solid var(--rim-border);
        border-radius: 8px;
        padding: 11px 15px;
        font-size: 0.95rem;
        transition: 0.2s;
        background-color: #FFFFFF;
    }

        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 3px rgba(255, 151, 96, 0.15);
            border-color: var(--rim-orange);
            background-color: #FFFFFF;
        }

    .form-label {
        color: var(--rim-text-main);
        font-weight: 500;
        font-size: 0.85rem;
        margin-bottom: 8px;
    }

    /* Sticky Image Container */
    .edit-image-box {
        border: 1px solid var(--rim-border);
        border-radius: 12px;
        background: var(--rim-card);
        padding: 20px;
        position: sticky;
        top: 2rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.01);
    }

    /* Buttons - คุมโทนส้ม-ขาว มนกลมกลืน */
    .btn-rim-save {
        background: var(--rim-orange);
        color: white;
        padding: 12px 35px;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.2s;
        border: 1px solid var(--rim-orange);
    }

        .btn-rim-save:hover {
            background: var(--rim-orange-hover);
            color: white;
            box-shadow: 0 4px 12px rgba(255, 151, 96, 0.2);
        }

    .btn-rim-back {
        color: var(--rim-text-muted);
        font-weight: 500;
        font-size: 0.95rem;
        text-decoration: none;
        transition: 0.2s;
        padding: 12px 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
    }

        .btn-rim-back:hover {
            color: var(--rim-text-main);
            background: #F0F2F5;
        }

    .btn-change-image {
        border: 1px solid var(--rim-border);
        background: #FAFAFA;
        color: var(--rim-text-main);
        font-weight: 500;
        font-size: 0.9rem;
        transition: 0.2s;
        border-radius: 8px;
    }

        .btn-change-image:hover {
            background: var(--rim-orange-light);
            color: var(--rim-orange-hover);
            border-color: var(--rim-orange);
        }
</style>

<div class="container-fluid px-lg-5 py-4">
    <div class="page-header-rim shadow-sm">
        <div class="row align-items-center">
            <div class="col-md-7">
                <p class="text-muted small mb-1 text-uppercase fw-semibold" style="letter-spacing: 2px;">Asset Management</p>
                <h2 class="fw-bold mb-0">แก้ไขข้อมูล<span style="color: var(--rim-orange)">รายละเอียดสินค้า</span></h2>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Index">
                    <i class="bi bi-arrow-left-short"></i> กลับสู่คลังสินค้า
                </a>
            </div>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="@ViewContext.RouteData.Values["id"]" />

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="edit-image-box text-center">
                    <label class="form-label d-block text-start fw-600 mb-3" style="text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; color: var(--rim-text-muted);">Product Image</label>
                    <div class="p-2 border rounded-3 mb-3 bg-light d-flex align-items-center justify-content-center" style="min-height: 280px;">
                        <img id="preview" src="/Products/@ViewData["ImageFileName"]" class="img-fluid rounded" style="max-height: 320px; object-fit: contain;"
                             onerror="this.src='https://placehold.co/600x600/f8f8f8/999?text=NO+IMAGE'" />
                    </div>
                    <label class="btn btn-change-image w-100 py-2.5 shadow-sm cursor-pointer">
                        <i class="bi bi-camera me-2"></i>เปลี่ยนรูปภาพสินค้า
                        <input type="file" class="d-none" asp-for="ImageFile" accept="image/*" onchange="previewImg(this)" />
                    </label>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="main-edit-card p-4 p-md-5">

                    <div class="mb-5">
                        <div class="group-title">
                            <i class="bi bi-sliders me-2" style="color: var(--rim-orange)"></i>Primary Specifications
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">ชื่อรุ่นสินค้า (Product Name)</label>
                            <input class="form-control" asp-for="Product_Name" placeholder="ระบุชื่อรุ่นล้อแม็ก..." />
                            <span asp-validation-for="Product_Name" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div>
                            <label class="form-label fw-semibold">คำอธิบายรายละเอียด (Description)</label>
                            <textarea class="form-control" asp-for="Description" rows="5" placeholder="ระบุรายละเอียดสเปกและข้อมูลทางเทคนิคของสินค้า..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-5">
                        <div class="group-title">
                            <i class="bi bi-tags me-2" style="color: var(--rim-orange)"></i>Commercial Identity
                        </div>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">แบรนด์สินค้า (Brand)</label>
                                <select class="form-select" asp-for="Brand_Id" asp-items="ViewBag.BrandList">
                                    <option value="">-- เลือกแบรนด์ --</option>
                                </select>
                                <span asp-validation-for="Brand_Id" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">ราคาทุน (THB)</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0 bg-light" style="padding-right: 5px; border-radius: 8px 0 0 8px; border-color: var(--rim-border);">฿</span>
                                    <input class="form-control border-start-0" style="border-radius: 0 8px 8px 0;" asp-for="CostPrice" type="number" step="0.01" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">ราคาขาย (THB)</label>
                                <div class="input-group">
                                    <span class="input-group-text border-end-0 bg-light" style="padding-right: 5px; border-radius: 8px 0 0 8px; border-color: var(--rim-border);">฿</span>
                                    <input class="form-control border-start-0" style="border-radius: 0 8px 8px 0;" asp-for="Price" type="number" step="0.01" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">สภาพสินค้า (Condition)</label>
                                <select class="form-select" asp-for="Condition">
                                    <option value="มือ 1">มือ 1 (ของใหม่)</option>
                                    <option value="มือ 2">มือ 2 (มือสอง)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn-rim-back">
                            <i class="bi bi-arrow-left me-2"></i>ย้อนกลับคลังสินค้า
                        </a>
                        <button type="submit" class="btn btn-rim-save shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> บันทึกการเปลี่ยนแปลง
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImg(input) {
            const preview = document.getElementById('preview');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}