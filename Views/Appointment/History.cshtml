@model IEnumerable<CS66_WebApplication1.Models.Appointment>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    body {
        font-family: 'Kanit', sans-serif;
        background-color: #F9FAFB;
    }

    .brand-header {
        background: linear-gradient(135deg, #FFFFFF 0%, #FFF2EB 100%);
        padding: 35px 40px;
        border-left: 6px solid #FF9760;
        border-radius: 12px;
        margin-bottom: 30px;
        border: 1px solid #EAEAEA;
        box-shadow: 0 4px 15px rgba(255, 151, 96, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-rim-orange {
        background: #FF9760;
        color: white;
        border: none;
        transition: 0.3s;
        font-weight: 500;
        padding: 10px 24px;
        border-radius: 50px;
        text-decoration: none;
    }

        .btn-rim-orange:hover {
            background: #f38349;
            color: white;
            box-shadow: 0 5px 15px rgba(255, 151, 96, 0.3);
        }

    /* สไตล์สำหรับการ์ดประวัติแต่ละรายการ */
    .history-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px 25px;
        margin-bottom: 15px;
        border: 1px solid #EAEAEA;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 20px;
    }

        .history-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border-color: #FF9760;
        }

    .date-box {
        background: #FFF2EB;
        color: #FF9760;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        min-width: 100px;
        flex-shrink: 0;
    }

        .date-box .day {
            font-size: 1.8rem;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 5px;
        }

        .date-box .month-year {
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
        }

    .history-details {
        flex-grow: 1;
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .status-pending {
        background: #FFF8E1;
        color: #FFA000;
    }

    .status-confirmed {
        background: #E8F5E9;
        color: #388E3C;
    }

    .status-default {
        background: #F1F3F5;
        color: #6C757D;
    }

    .status-payment {
        background: #FFF3E0;
        color: #E65100;
    }

    .status-verify {
        background: #E3F2FD;
        color: #1565C0;
    }

    .status-completed {
        background: #E8F5E9;
        color: #2E7D32;
    }

    .status-cancelled {
        background: #FFEBEE;
        color: #C62828;
    }

    .slip-upload-form {
        background: #FFF9F5;
        border: 1px dashed #FF9760;
        border-radius: 12px;
        padding: 15px;
        margin-top: 10px;
    }

    .empty-state {
        background: #ffffff;
        border-radius: 16px;
        padding: 60px 20px;
        text-align: center;
        border: 1px dashed #FF9760;
    }

    .empty-state-icon {
        font-size: 4rem;
        color: #FF9760;
        opacity: 0.5;
        margin-bottom: 20px;
    }

    /* ปรับแต่งสำหรับหน้าจอมือถือ */
    @@media (max-width: 768px) {
        .history-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .status-badge {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="container py-5">

    <div class="brand-header flex-column flex-md-row gap-3">
        <div>
            <h2 class="fw-bold mb-0">ประวัติ<span style="color: #FF9760;">การนัดหมาย</span></h2>
            <p class="text-muted small mt-2 mb-0">ตรวจสอบสถานะและประวัติการจองคิวบริการของคุณได้ที่นี่</p>
        </div>
        <a asp-controller="Appointment" asp-action="Create" class="btn-rim-orange">
            <i class="bi bi-plus-lg me-1"></i> จองคิวเพิ่ม
        </a>
    </div>

    <div class="row">
        <div class="col-12">

            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="history-card">
                        <div class="date-box">
                            <div class="day">@item.Appointment_Date.ToString("dd")</div>
                            <div class="month-year">@item.Appointment_Date.ToString("MMM yyyy")</div>
                        </div>

                        <div class="history-details">
                            <h5 class="fw-bold mb-1">@(item.Service?.Service_Name ?? "บริการทั่วไป")</h5>
                            <div class="text-muted small mb-2">
                                <i class="bi bi-clock me-1"></i> เวลา: <strong class="text-dark">@item.Appointment_Date.ToString("HH:mm") น.</strong>
                            </div>
                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <div class="small text-muted" style="background: #F9FAFB; padding: 8px 12px; border-radius: 8px; border-left: 3px solid #EAEAEA;">
                                    <i class="bi bi-chat-left-text me-1"></i> หมายเหตุ: @item.Notes
                                </div>
                            }
                        </div>

                        <div>
                            @if (item.Status == "รออนุมัติ")
                            {
                                <span class="status-badge status-pending">
                                    <i class="bi bi-hourglass-split"></i> รออนุมัติ
                                </span>
                            }
                            else if (item.Status == "ยืนยันแล้ว")
                            {
                                <span class="status-badge status-confirmed">
                                    <i class="bi bi-check-circle-fill"></i> ยืนยันแล้ว
                                </span>
                            }
                            else if (item.Status == "กำลังทำ")
                            {
                                <span class="status-badge status-pending">
                                    <i class="bi bi-arrow-repeat"></i> กำลังดำเนินการ
                                </span>
                            }
                            else if (item.Status == "รอชำระเงิน")
                            {
                                <span class="status-badge status-payment">
                                    <i class="bi bi-wallet2"></i> รอชำระเงิน
                                </span>
                                <div class="slip-upload-form mt-2">
                                    <p class="small fw-bold mb-2" style="color: #E65100;">
                                        <i class="bi bi-info-circle-fill me-1"></i> ค่าบริการ: ฿@(item.Service?.Price.ToString("N0") ?? "-")
                                    </p>
                                    <form asp-controller="Appointment" asp-action="UploadServiceSlip" method="post" enctype="multipart/form-data">
                                        <input type="hidden" name="appointmentId" value="@item.Id" />
                                        <input type="file" name="slip" class="form-control form-control-sm mb-2" accept=".jpg,.jpeg,.png" required />
                                        <button type="submit" class="btn btn-sm w-100 fw-bold" style="background: #FF9760; color: white; border-radius: 8px;">
                                            <i class="bi bi-upload me-1"></i> อัปโหลดสลิป
                                        </button>
                                    </form>
                                </div>
                            }
                            else if (item.Status == "รอยืนยันชำระเงิน")
                            {
                                <span class="status-badge status-verify">
                                    <i class="bi bi-clock-history"></i> รอยืนยันชำระเงิน
                                </span>
                                @if (!string.IsNullOrEmpty(item.ServicePaymentSlip))
                                {
                                    <div class="mt-2">
                                        <a href="/slips/@item.ServicePaymentSlip" target="_blank" class="small text-primary">
                                            <i class="bi bi-image me-1"></i> ดูสลิปที่ส่งแล้ว
                                        </a>
                                    </div>
                                }
                            }
                            else if (item.Status == "เสร็จสิ้น")
                            {
                                <span class="status-badge status-completed">
                                    <i class="bi bi-check-all"></i> เสร็จสิ้น
                                </span>
                            }
                            else if (item.Status == "ยกเลิกแล้ว")
                            {
                                <span class="status-badge status-cancelled">
                                    <i class="bi bi-x-circle-fill"></i> ยกเลิกแล้ว
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-default">
                                    <i class="bi bi-info-circle"></i> @(string.IsNullOrEmpty(item.Status) ? "รอดำเนินการ" : item.Status)
                                </span>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state shadow-sm">
                    <div class="empty-state-icon">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                    <h4 class="fw-bold text-dark">ยังไม่มีประวัติการจอง</h4>
                    <p class="text-muted mb-4">คุณยังไม่เคยทำการนัดหมายบริการใดๆ กับเราเลยครับ</p>
                    <a asp-controller="Appointment" asp-action="Create" class="btn-rim-orange">
                        เริ่มต้นจองบริการครั้งแรก
                    </a>
                </div>
            }

        </div>
    </div>
</div>