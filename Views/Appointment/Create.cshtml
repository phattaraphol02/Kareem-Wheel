@model IEnumerable<CS66_WebApplication1.Models.Service>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container-fluid px-lg-5 py-4">
    <div class="brand-header shadow-sm" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFF2EB 100%); padding: 35px 40px; border-left: 6px solid #FF9760; border-radius: 12px; margin-bottom: 30px; border: 1px solid #EAEAEA;">
        <h2 class="fw-bold mb-0">เลือก<span style="color: #FF9760;">ประเภทบริการ</span></h2>
        <p class="text-muted small mt-2 mb-0">โปรดเลือกบริการที่ท่านต้องการ เพื่อดำเนินการนัดหมายต่อไป</p>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                bool isTooShortForWeb = item.Duration < 60;
                bool isWebBookable = item.IsActive && !isTooShortForWeb;
                <div class="col-md-3 mb-4">
                    <div class="card lux-card h-100 border-0 shadow-sm" style="border-radius: 16px; transition: 0.3s; @(!isWebBookable ? "opacity: 0.75;" : "")">
                        <div class="card-body p-4 text-center">

                            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                                 style="width: 60px; height: 60px; background: @(isWebBookable ? "#FFF2EB" : "#F5F5F5"); color: @(isWebBookable ? "#FF9760" : "#9E9E9E"); border-radius: 50%; font-size: 1.5rem;">
                                <i class="bi bi-tools"></i>
                            </div>

                            <h5 class="fw-bold mb-2">@item.Service_Name</h5>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-clock me-1"></i> ใช้เวลาประมาณ @item.Duration นาที
                            </p>

                            @if (isWebBookable)
                            {
                                <form asp-action="SelectService" method="post">
                                    <input type="hidden" name="serviceId" value="@item.Service_Id" />
                                    <button type="submit" class="btn btn-rim-orange w-100 rounded-pill py-2" style="background: #FF9760; color: white; border: none; font-weight: 600;">
                                        เลือกบริการ
                                    </button>
                                </form>
                            }
                            else if (isTooShortForWeb)
                            {
                                <span class="badge bg-light text-secondary border mb-2 d-block py-2" style="font-weight: 500;">
                                    <i class="bi bi-shop me-1"></i> บริการหน้าร้าน (Walk-in)
                                </span>
                                <button type="button" class="btn btn-outline-secondary w-100 rounded-pill py-2"
                                        style="font-weight: 600;"
                                        onclick="Swal.fire({ icon: 'info', title: 'บริการหน้าร้านเท่านั้น', text: 'บริการ @item.Service_Name ใช้เวลาไม่ถึง 1 ชั่วโมง จึงไม่เปิดให้จองผ่านเว็บ กรุณาแวะมาที่ร้านได้เลยครับ ไม่ต้องจองล่วงหน้า', confirmButtonColor: '#FF9760' })">
                                    ดูรายละเอียด
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary w-100 rounded-pill py-2"
                                        style="background: #6c757d; color: white; border: none; font-weight: 600; cursor: not-allowed;"
                                        onclick="Swal.fire({ icon: 'warning', title: 'ขออภัยในความไม่สะดวก', text: 'ขออภัยด้วยค่ะ บริการ @item.Service_Name ไม่พร้อมให้บริการในขณะนี้', confirmButtonColor: '#FF9760' })">
                                    ไม่พร้อมให้บริการ
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">ไม่พบรายการบริการในขณะนี้</p>
            </div>
        }
    </div>
</div>

<style>
    /* การ์ดจะขยับขึ้นเฉพาะชิ้นที่เปิดบริการปกติ */
    .lux-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 20px rgba(255, 151, 96, 0.15) !important;
    }

    .btn-rim-orange:hover {
    background: #f38349 !important;
    }
</style>