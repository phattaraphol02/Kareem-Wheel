@model CS66_WebApplication1.Models.Product

@{
    ViewData["Title"] = Model.Product_Name + " | Premium Wheel Selection";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --peach-primary: #FF9259;
        --peach-hover: #FF7B39;
        --peach-light: #FFF2EC;
        --text-dark: #2D2D2D;
        --text-muted: #8C8A89;
        --border-color: #F3ECE8;
        --bg-light: #FDFBFB;
    }

    body {
        background-color: var(--bg-light);
        font-family: 'Kanit', sans-serif;
    }

    /* --- Image Section --- */
    .product-img-wrapper {
        background: #FFFFFF;
        border-radius: 30px;
        padding: 60px;
        border: 1px solid var(--border-color);
        box-shadow: 0 10px 30px rgba(0,0,0,0.03);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* --- Details --- */
    .brand-tag {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        color: var(--peach-primary);
        text-transform: uppercase;
        font-weight: 700;
        background: var(--peach-light);
        padding: 6px 16px;
        border-radius: 50px;
    }

    .prod-title {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        font-size: 3rem;
        color: var(--text-dark);
        margin: 20px 0;
        line-height: 1.1;
    }

    .price-display {
        font-family: 'Montserrat', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        color: var(--text-dark);
    }

    /* --- Buttons --- */
    .btn-action {
        background: var(--text-dark);
        color: white;
        padding: 18px 35px;
        border-radius: 14px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all 0.3s;
    }

        .btn-action:hover {
            background: var(--peach-primary);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 146, 89, 0.3);
        }

    .btn-back {
        padding: 18px 25px;
        border-radius: 14px;
        border: 1.5px solid var(--border-color);
        background: #fff;
        color: var(--text-dark);
        transition: 0.3s;
    }

        .btn-back:hover {
            background: var(--border-color);
        }
</style>

<div class="container py-5">
    <div class="row align-items-center g-5">

        <div class="col-lg-6">
            <div class="product-img-wrapper animate__animated animate__fadeInLeft">
                @if (!string.IsNullOrEmpty(Model.ImageFileName))
                {
                    <img src="/Products/@Model.ImageFileName" class="img-fluid" alt="@Model.Product_Name" style="max-height: 400px;">
                }
                else
                {
                    <img src="/Products/no-image.png" class="img-fluid" alt="No Image">
                }
            </div>
        </div>

        <div class="col-lg-6 animate__animated animate__fadeInRight">
            <div class="ps-lg-4">
                @{
                    bool detailOutOfStock = Model.Quantity <= 0;
                }
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="brand-tag">@(Model.Brand?.Brand_Name ?? "Premium Collection")</span>
                    @if (detailOutOfStock)
                    {
                        <span class="badge rounded-pill bg-danger text-white border-0"><i class="bi bi-x-circle-fill me-1"></i> สินค้าหมดชั่วคราว</span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-light text-success border"><i class="bi bi-check-circle-fill me-1"></i> มีสินค้า @Model.Quantity ชิ้น</span>
                    }
                </div>

                <h1 class="prod-title">@Model.Product_Name</h1>

                <div class="mb-4">
                    <div class="price-display">฿@Model.Price.ToString("N0")</div>
                    <small class="text-muted fw-light">ราคารวมภาษีมูลค่าเพิ่มเรียบร้อยแล้ว</small>
                </div>

                <div class="mb-5">
                    <h6 class="text-uppercase fw-bold mb-3" style="letter-spacing: 1.5px; font-size: 0.8rem; color: var(--peach-primary);">รายละเอียดสินค้า</h6>
                    <p class="text-secondary" style="line-height: 1.8; font-size: 1rem;">@Model.Description</p>
                </div>

                <div class="d-flex gap-3">
                    @if (detailOutOfStock)
                    {
                        <button class="btn flex-grow-1 py-3" disabled
                                style="background:#e9ecef; color:#6c757d; border-radius:14px; font-weight:700; font-size:0.9rem; letter-spacing:1px; border:1px solid #dee2e6; cursor:not-allowed;">
                            <i class="bi bi-x-circle me-2"></i> สินค้าหมดชั่วคราว
                        </button>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Details", "Product", new { id = Model.Product_Id })"
                           class="btn btn-action flex-grow-1" id="btn-add">
                            <i class="bi bi-cart-plus me-2"></i> สั่งซื้อสินค้า
                        </a>
                    }
                    <a asp-controller="CustomerDashboard" asp-action="Index" class="btn btn-back">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>

                <div class="mt-5 text-muted small" style="line-height: 2;">
                    <i class="bi bi-truck me-2 text-peach-primary"></i> จัดส่งฟรีสำหรับออเดอร์ 20,000 บาทขึ้นไป <br>
                    <i class="bi bi-arrow-repeat me-2 text-peach-primary"></i> เปลี่ยนสินค้าได้ภายใน 7 วัน โดยไม่มีเงื่อนไข
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var btnAdd = document.getElementById('btn-add');
    if (btnAdd) {
        btnAdd.addEventListener('click', function() {
            this.innerHTML = '<i class="bi bi-check2-circle me-2"></i> กำลังดำเนินการ...';
            this.style.backgroundColor = 'var(--peach-primary)';
        });
    }
</script>