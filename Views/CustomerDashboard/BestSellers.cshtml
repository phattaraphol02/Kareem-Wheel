@model List<CS66_WebApplication1.Models.BestSellerItem>

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "สินค้าขายดี - Kareem Wheel";
}

<link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&family=Montserrat:wght@500;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --peach-primary: #FF9259;
        --peach-hover: #FF7B39;
        --peach-light: #FFF2EC;
        --text-dark: #2F2E2E;
        --text-muted: #8C8A89;
        --border-color: #EAEAEA;
    }

    body { background: #F9FAFB; font-family: 'Kanit', sans-serif; color: var(--text-dark); }

    .rim-page-header { padding: 50px 0 30px; text-align: center; }

    .rim-title {
        font-family: 'Montserrat', sans-serif; font-weight: 900;
        font-size: 2.2rem; margin-bottom: 5px;
    }

    .header-divider {
        width: 60px; height: 4px; background: var(--peach-primary);
        margin: 15px auto; border-radius: 2px;
    }

    .rank-card {
        background: #FFF; border: 1px solid var(--border-color); border-radius: 18px;
        padding: 20px; display: flex; align-items: center; gap: 20px;
        margin-bottom: 16px; transition: all 0.25s;
    }

        .rank-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.06);
            border-color: var(--peach-primary);
        }

    .rank-badge {
        width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 1.3rem;
        background: var(--peach-light); color: var(--peach-primary);
    }

    .rank-1 { background: linear-gradient(135deg, #FFD700, #FFA000); color: #fff; box-shadow: 0 6px 18px rgba(255,160,0,0.35); }
    .rank-2 { background: linear-gradient(135deg, #C0C0C0, #9E9E9E); color: #fff; box-shadow: 0 6px 18px rgba(158,158,158,0.3); }
    .rank-3 { background: linear-gradient(135deg, #CD7F32, #A05A2C); color: #fff; box-shadow: 0 6px 18px rgba(160,90,44,0.3); }

    .product-thumb {
        width: 80px; height: 80px; object-fit: cover;
        border-radius: 12px; border: 1px solid var(--border-color); flex-shrink: 0;
    }

    .product-info { flex-grow: 1; min-width: 0; }

    .product-name {
        font-weight: 600; font-size: 1.05rem; margin-bottom: 4px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    .product-brand { font-size: 0.82rem; color: var(--text-muted); }

    .product-price {
        font-family: 'Montserrat', sans-serif; font-weight: 800;
        color: var(--peach-primary); font-size: 1.15rem; margin-top: 6px;
    }

    .sold-pill {
        background: var(--peach-light); color: var(--peach-primary);
        padding: 6px 16px; border-radius: 30px; font-size: 0.82rem;
        font-weight: 600; white-space: nowrap;
    }

    .stock-out-pill {
        background: #FFEBEE; color: #C62828;
        padding: 6px 16px; border-radius: 30px; font-size: 0.8rem; font-weight: 600;
    }

    .btn-buy {
        background: var(--peach-primary); color: #fff; border: none;
        border-radius: 50px; padding: 10px 26px; font-weight: 600;
        font-size: 0.88rem; text-decoration: none; white-space: nowrap; transition: 0.25s;
    }

        .btn-buy:hover {
            background: var(--peach-hover); color: #fff;
            box-shadow: 0 6px 18px rgba(255,146,89,0.3);
        }

    .empty-state-box {
        background: #FFF; border: 1px dashed var(--border-color); border-radius: 24px;
        padding: 60px 20px; text-align: center;
    }

    @@media (max-width: 768px) {
        .rank-card { flex-wrap: wrap; gap: 14px; }
        .product-info { width: 100%; order: 3; }
        .rank-card .text-end { width: 100%; order: 4; display: flex; justify-content: space-between; align-items: center; }
    }
</style>

<div class="container pb-5">

    <div class="rim-page-header">
        <h2 class="rim-title">สินค้า<span style="color: var(--peach-primary);">ขายดี</span></h2>
        <div class="header-divider"></div>
        <p class="text-muted">10 อันดับสินค้าที่ลูกค้าสั่งซื้อมากที่สุด</p>
    </div>

    <div class="mx-auto" style="max-width: 900px;">
        @if (Model != null && Model.Any())
        {
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                var p = item.Product;
                int rank = i + 1;
                string rankClass = rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "";

                <div class="rank-card">
                    <div class="rank-badge @rankClass">
                        @if (rank <= 3)
                        {
                            <i class="bi bi-trophy-fill"></i>
                        }
                        else
                        {
                            @rank
                        }
                    </div>

                    <img src="~/Products/@p.ImageFileName" class="product-thumb" alt="@p.Product_Name"
                         onerror="this.src='/Products/default.png'" />

                    <div class="product-info">
                        <div class="product-name">@p.Product_Name</div>
                        <div class="product-brand">
                            <i class="bi bi-tag me-1"></i>@(p.Brand?.Brand_Name ?? "ไม่ระบุแบรนด์")
                        </div>
                        <div class="product-price">฿@p.Price.ToString("N0")</div>
                    </div>

                    <div class="text-end">
                        <div class="mb-2">
                            <span class="sold-pill"><i class="bi bi-fire me-1"></i>ขายแล้ว @item.SoldQty ชิ้น</span>
                        </div>
                        @if (p.Quantity > 0)
                        {
                            <a asp-controller="Cart" asp-action="CheckoutNow" asp-route-id="@p.Product_Id" class="btn-buy">
                                <i class="bi bi-cart-plus me-1"></i> สั่งซื้อ
                            </a>
                        }
                        else
                        {
                            <span class="stock-out-pill"><i class="bi bi-x-circle me-1"></i>สินค้าหมด</span>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state-box">
                <i class="bi bi-bar-chart-line" style="font-size: 4rem; color: var(--peach-light);"></i>
                <h4 class="fw-bold mt-3 mb-2">ยังไม่มีข้อมูลสินค้าขายดี</h4>
                <p class="text-muted mb-4">เมื่อมีการสั่งซื้อและชำระเงินเข้ามา อันดับจะแสดงที่นี่</p>
                <a asp-controller="CustomerDashboard" asp-action="Index" class="btn-buy">
                    เลือกดูสินค้าทั้งหมด <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        }
    </div>
</div>
