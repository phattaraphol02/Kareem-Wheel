@model List<CS66_WebApplication1.Models.CartItem>
@{
    Layout = null;
    var total = Model?.Sum(x => x.Price * x.Qty) ?? 0;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
            :root {
                --rim-orange: #FF9760;
                --rim-orange-light: #FFF2EB;
                --rim-bg-light: #F9FAFB;
            }

            body {
                background: var(--rim-bg-light);
                font-family: 'Kanit', sans-serif;
            }

            .cart-container {
                padding: 40px 20px;
                max-width: 1100px;
                margin: auto;
            }

            .cart-card {
                background: white;
                border-radius: 20px;
                border: 1px solid #eee;
                padding: 30px;
                box-shadow: 0 5px 15px rgba(0,0,0,0.03);
            }

            /* ปุ่มกลับไปเลือกสินค้า */
            .btn-rim-back {
                display: inline-flex;
                align-items: center;
                padding: 10px 24px;
                border: 1px solid #EAEAEA;
                background: #FFFFFF;
                color: #7A7A7A;
                border-radius: 30px;
                font-weight: 500;
                transition: all 0.3s ease;
                text-decoration: none;
                font-size: 0.95rem;
                margin-bottom: 25px;
            }

                .btn-rim-back:hover {
                    border-color: var(--rim-orange);
                    color: var(--rim-orange);
                    background: var(--rim-orange-light);
                    transform: translateX(-5px);
                    box-shadow: 0 4px 12px rgba(255, 151, 96, 0.1);
                }

            .qty-box {
                border: 1px solid #eee;
                border-radius: 8px;
                display: inline-flex;
            }

            .qty-btn {
                border: none;
                background: white;
                padding: 5px 15px;
                text-decoration: none;
                color: #333;
            }

                .qty-btn:hover {
                    background: #f8f9fa;
                }

            .btn-checkout {
                background: var(--rim-orange);
                color: white;
                border-radius: 12px;
                padding: 15px;
                font-weight: 600;
                text-decoration: none;
                display: block;
                text-align: center;
                transition: 0.3s;
            }

                .btn-checkout:hover {
                    background: #f38349;
                    color: white;
                }
    </style>
</head>
<body>
    <main class="cart-container">
        <a asp-controller="CustomerDashboard" asp-action="Index" class="btn-rim-back">
            <i class="bi bi-chevron-left me-2"></i> กลับไปเลือกสินค้าต่อ
        </a>

        @if (Model == null || Model.Count == 0)
        {
            <div class="cart-card text-center py-5">
                <i class="bi bi-cart-x display-1 text-muted"></i>
                <h4 class="mt-3">ตะกร้าของคุณว่างเปล่า</h4>
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark mt-3 rounded-pill">ไปเลือกซื้อสินค้ากันเลย</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-card">
                        <table class="table align-middle">
                            <thead class="text-muted text-uppercase" style="font-size: 0.8rem;">
                                <tr><th>สินค้า</th><th>ราคา</th><th class="text-center">จำนวน</th><th class="text-end">รวม</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="/Products/@item.ImageFileName" style="width:60px; height:60px; object-fit:contain;" class="rounded-3 me-3 bg-light">
                                                <span class="fw-semibold">@item.Product_Name</span>
                                            </div>
                                        </td>
                                        <td>฿@item.Price.ToString("N0")</td>
                                        <td class="text-center">
                                            <div class="qty-box">
                                                <a class="qty-btn" asp-action="UpdateQty" asp-route-id="@item.Product_Id" asp-route-qty="-1"><i class="bi bi-dash"></i></a>
                                                <span class="px-3 fw-bold">@item.Qty</span>
                                                <a class="qty-btn" asp-action="UpdateQty" asp-route-id="@item.Product_Id" asp-route-qty="1"><i class="bi bi-plus"></i></a>
                                            </div>
                                        </td>
                                        <td class="text-end fw-bold">฿@((item.Price * item.Qty).ToString("N0"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="cart-card">
                        <h5 class="fw-bold mb-4">สรุปรายการ</h5>
                        <div class="d-flex justify-content-between mb-3"><span>ยอดรวม</span> <span class="fw-bold">฿@total.ToString("N0")</span></div>
                        <div class="d-flex justify-content-between mb-4"><span>ค่าจัดส่ง</span> <span class="text-success fw-bold">ฟรี</span></div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 fw-bold">ยอดสุทธิ</span>
                            <span class="h5 fw-bold" style="color: var(--rim-orange);">฿@total.ToString("N0")</span>
                        </div>
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-checkout w-100">ดำเนินการชำระเงิน</a>
                    </div>
                </div>
            </div>
        }
    </main>
</body>
</html>