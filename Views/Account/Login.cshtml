@model CS66_WebApplication1.Models.LoginVm
@{
    ViewData["Title"] = "เข้าสู่ระบบ - Premium Rims Store";
    Layout = null; // ปิด Layout ชั่วคราวเพื่อให้แสดงผลเต็มหน้าจอ
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Kanit:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <style>
            :root {
                --peach-primary: #FF9259;
                --peach-hover: #FF7B39;
                --peach-light: #FFF2EC;
                --peach-soft: #FFF9F6;
                --text-dark: #2F2E2E;
                --text-muted: #8C8A89;
                --border-color: #F3ECE8;
                --bg-white: #FFFFFF;
            }

            body {
                /* พื้นหลังสีขาวอมพีชอ่อนๆ ไล่ระดับ */
                background: linear-gradient(135deg, #FFFFFF 0%, var(--peach-soft) 100%);
                font-family: 'Kanit', sans-serif;
                color: var(--text-dark);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0;
                position: relative;
                overflow-x: hidden;
            }

                /* ตกแต่งพื้นหลังด้วยวงกลมสีส้มพีชเบลอๆ */
                body::before {
                    content: '';
                    position: absolute;
                    top: -10%;
                    left: -10%;
                    width: 500px;
                    height: 500px;
                    background: radial-gradient(circle, rgba(255,146,89,0.15) 0%, rgba(255,255,255,0) 70%);
                    z-index: 0;
                }

                body::after {
                    content: '';
                    position: absolute;
                    bottom: -10%;
                    right: -10%;
                    width: 600px;
                    height: 600px;
                    background: radial-gradient(circle, rgba(255,146,89,0.1) 0%, rgba(255,255,255,0) 70%);
                    z-index: 0;
                }

            /* ── Main Container ── */
            .login-wrapper {
                width: 100%;
                max-width: 550px; /* ปรับขนาดให้พอดีกับฟอร์มเดี่ยว */
                padding: 20px;
                z-index: 1;
            }

            .peach-login-card {
                background: var(--bg-white);
                border-radius: 30px;
                box-shadow: 0 20px 50px rgba(255, 146, 89, 0.1);
                border: 1px solid var(--border-color);
                overflow: hidden;
                position: relative;
            }

            /* ── Form Side ── */
            .peach-form-side {
                width: 100%;
                padding: 70px 50px 50px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                background: var(--bg-white);
            }

            .back-to-home {
                position: absolute;
                top: 25px;
                right: 30px;
                color: var(--text-muted);
                text-decoration: none;
                font-size: 0.95rem;
                font-weight: 500;
                transition: 0.3s;
                display: flex;
                align-items: center;
                gap: 6px;
                z-index: 10;
            }

                .back-to-home:hover {
                    color: var(--peach-primary);
                }

            .form-header {
                text-align: center;
                margin-bottom: 30px;
            }

                .form-header .logo-icon {
                    font-size: 3rem;
                    color: var(--peach-primary);
                    margin-bottom: 10px;
                }

                .form-header h2 {
                    font-family: 'Montserrat', sans-serif;
                    font-weight: 900;
                    font-size: 2.2rem;
                    color: var(--text-dark);
                    margin-bottom: 5px;
                }

                    .form-header h2 span {
                        color: var(--peach-primary);
                    }

            /* ── Input Styling ── */
            .input-wrapper {
                margin-bottom: 22px;
                position: relative;
            }

            .input-label {
                font-family: 'Montserrat', sans-serif;
                font-size: 0.85rem;
                font-weight: 700;
                color: var(--text-dark);
                text-transform: uppercase;
                letter-spacing: 0.5px;
                margin-bottom: 8px;
                display: block;
            }

            .peach-input {
                width: 100%;
                padding: 15px 20px 15px 50px;
                border: 2px solid var(--border-color);
                border-radius: 14px;
                background-color: var(--bg-white);
                font-size: 1rem;
                color: var(--text-dark);
                transition: all 0.3s ease;
                font-family: 'Kanit', sans-serif;
            }

                .peach-input:focus {
                    outline: none;
                    border-color: var(--peach-primary);
                    box-shadow: 0 0 0 4px var(--peach-light);
                }

                .peach-input::placeholder {
                    color: #C0C0C0;
                    font-weight: 300;
                }

            .input-icon {
                position: absolute;
                left: 20px;
                top: 42px;
                font-size: 1.2rem;
                color: #B0B0B0;
                transition: 0.3s;
            }

            .peach-input:focus + .input-icon,
            .peach-input:not(:placeholder-shown) + .input-icon {
                color: var(--peach-primary);
            }

            .toggle-password {
                position: absolute;
                right: 20px;
                top: 42px;
                cursor: pointer;
                color: #B0B0B0;
                font-size: 1.2rem;
                transition: 0.2s;
            }

                .toggle-password:hover {
                    color: var(--peach-primary);
                }

            /* ── Buttons ── */
            .btn-peach {
                background: var(--peach-primary);
                color: white;
                border: none;
                padding: 16px;
                border-radius: 14px;
                font-family: 'Montserrat', sans-serif;
                font-weight: 700;
                font-size: 1.05rem;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                width: 100%;
                transition: all 0.3s ease;
                margin-top: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                box-shadow: 0 8px 20px rgba(255, 146, 89, 0.2);
            }

                .btn-peach:hover {
                    background: var(--peach-hover);
                    transform: translateY(-3px);
                    box-shadow: 0 12px 25px rgba(255, 146, 89, 0.35);
                }

            /* ── Divider & Register Link ── */
            .peach-divider {
                display: flex;
                align-items: center;
                text-align: center;
                color: var(--text-muted);
                margin: 35px 0 25px;
                font-size: 0.85rem;
                font-family: 'Montserrat', sans-serif;
                font-weight: 600;
            }

                .peach-divider::before,
                .peach-divider::after {
                    content: '';
                    flex: 1;
                    border-bottom: 1px solid var(--border-color);
                }

                .peach-divider:not(:empty)::before {
                    margin-right: .5em;
                }

                .peach-divider:not(:empty)::after {
                    margin-left: .5em;
                }

            .register-box {
                text-align: center;
                background: var(--peach-soft);
                padding: 20px;
                border-radius: 14px;
                border: 1px dashed var(--peach-light);
            }

            .register-link {
                color: var(--peach-primary);
                font-weight: 700;
                text-decoration: none;
                transition: 0.3s;
                font-size: 1.05rem;
            }

                .register-link:hover {
                    color: var(--peach-hover);
                    text-decoration: underline;
                }

            .validation-error {
                font-size: 0.85rem;
                color: #DC3545;
                margin-top: 5px;
                font-weight: 500;
                display: block;
            }

            /* ── Responsive ── */
            @@media (max-width: 576px) {
                .peach-form-side {
                    padding: 50px 30px 40px;
                }

                .back-to-home {
                    top: 20px;
                    right: 20px;
                }
            }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <div class="peach-login-card animate__animated animate__fadeInUp" style="animation-duration: 0.8s;">

            <!-- Link กลับหน้าหลัก -->
            <a asp-controller="Home" asp-action="Index" class="back-to-home">
                <i class="bi bi-house-door"></i> กลับ
            </a>

            <!-- ── ฝั่งฟอร์ม (ตรงกลาง) ── -->
            <div class="peach-form-side">
                <div class="form-header">
                    <i class="bi bi-shield-check logo-icon"></i>
                    <h2>LOG <span>IN</span></h2>
                    <p class="text-muted" style="font-size: 0.95rem;">กรุณากรอกข้อมูลเพื่อเข้าสู่ระบบบัญชีของคุณ</p>
                </div>

                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" style="border-radius: 12px; font-size: 0.9rem; background-color: #FFF0F0; border-color: #FFD6D6; color: #D32F2F;">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> ข้อมูลการเข้าสู่ระบบไม่ถูกต้อง
                        </div>
                    }

                    <!-- Input: Email -->
                    <div class="input-wrapper">
                        <label asp-for="Customer_Email" class="input-label">อีเมล (Email Address)</label>
                        <input asp-for="Customer_Email" class="peach-input" placeholder="example@email.com" autocomplete="email" />
                        <i class="bi bi-envelope input-icon"></i>
                        <span asp-validation-for="Customer_Email" class="validation-error"></span>
                    </div>

                    <!-- Input: Password -->
                    <div class="input-wrapper">
                        <label asp-for="Password" class="input-label">รหัสผ่าน (Password)</label>
                        <input asp-for="Password" type="password" class="peach-input" id="passwordInput" placeholder="••••••••" autocomplete="current-password" />
                        <i class="bi bi-lock input-icon"></i>
                        <i class="bi bi-eye-slash toggle-password" id="togglePassword" onclick="togglePasswordVisibility()"></i>
                        <span asp-validation-for="Password" class="validation-error"></span>
                    </div>

                    <div class="d-flex justify-content-end mb-4">
                        <a href="#" class="text-muted" style="font-size: 0.85rem; text-decoration: underline;">ลืมรหัสผ่านใช่หรือไม่?</a>
                    </div>

                    <button type="submit" class="btn-peach">
                        เข้าสู่ระบบ <i class="bi bi-arrow-right-circle fs-5"></i>
                    </button>
                </form>

                <div class="peach-divider">NEW USER</div>

                <!-- กรอบสมัครสมาชิกแบบน่ารักๆ -->
                <div class="register-box">
                    <p class="text-muted mb-1" style="font-size: 0.9rem;">ยังไม่มีบัญชีสมาชิก?</p>
                    <a asp-controller="Account" asp-action="Register" class="register-link">สมัครสมาชิกที่นี่</a>
                </div>
            </div>

        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ฟังก์ชันสำหรับเปิด/ปิดการมองเห็นรหัสผ่าน
        function togglePasswordVisibility() {
        const passwordInput = document.getElementById('passwordInput');
        const toggleIcon = document.getElementById('togglePassword');

        if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        toggleIcon.classList.remove('bi-eye-slash');
        toggleIcon.classList.add('bi-eye');
        } else {
        passwordInput.type = 'password';
        toggleIcon.classList.remove('bi-eye');
        toggleIcon.classList.add('bi-eye-slash');
        }
        }

        // จัดการเรื่องการแจ้งเตือน Error จาก Controller
        $(document).ready(function () {
        var errorMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"] as string ?? ""));

        // ถ้ามี Error ให้การ์ดสั่นเตือน
        if ($('.alert-danger').length > 0 || errorMessage.trim() !== '') {
        $('.peach-login-card').removeClass('animate__fadeInUp').addClass('animate__shakeX');
        }

        // แจ้งเตือน SweetAlert ถ้าบัญชีโดนระงับ
        if (errorMessage && errorMessage.trim() !== '') {
        Swal.fire({
        title: 'เข้าสู่ระบบไม่สำเร็จ',
        text: errorMessage,
        icon: 'error',
        confirmButtonColor: '#FF9259',
        confirmButtonText: 'ตกลง',
        customClass: {
        confirmButton: 'px-4 py-2 rounded-pill font-weight-bold'
        }
        });
        }
        });
    </script>
</body>
</html>