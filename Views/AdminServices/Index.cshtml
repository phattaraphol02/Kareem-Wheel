@model IEnumerable<CS66_WebApplication1.Models.Service>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="brand-header shadow-sm" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFF2EB 100%); padding: 35px 40px; border-left: 6px solid #FF9760; border-radius: 12px; margin-bottom: 30px; border: 1px solid #EAEAEA;">
        <div class="row align-items-center">
            <div class="col-md-7">
                <p class="text-muted small mb-1 text-uppercase fw-semibold" style="letter-spacing: 2px;">บริการทะเบียนข้อมูลกลาง</p>
                <h2 class="fw-bold mb-0">ระบบจัดการ<span style="color: #FF9760;">ข้อมูลบริการ</span></h2>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
             
                <a class="btn btn-rim-orange px-4 py-2" asp-action="Create" style="background: #FF9760; color: white; border-radius: 30px;">
                    <i class="bi bi-plus-lg me-1"></i> เพิ่มบริการใหม่
                </a>
            </div>
        </div>
    </div>

    <div class="card lux-card animate__animated animate__fadeInUp" style="border: 1px solid #EAEAEA; border-radius: 12px; background: #FFFFFF; overflow: hidden;">
        <div class="card-header bg-white py-4 px-4 border-bottom-0">
            <h5 class="mb-0 fw-semibold" style="font-size: 1.05rem;">ทำเนียบรายการบริการทั้งหมด</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background: #FAFAFA;">
                    <tr>
                        <th class="ps-4" style="font-size: 0.85rem; padding: 18px 20px;">ID</th>
                        <th style="font-size: 0.85rem; padding: 18px 20px;">ชื่อบริการ</th>
                        <th class="text-end" style="font-size: 0.85rem; padding: 18px 20px;">ราคา (บาท)</th>
                        <th class="text-center" style="font-size: 0.85rem; padding: 18px 20px; width: 150px;">สถานะ</th>
                        <th class="text-center pe-4" style="font-size: 0.85rem; padding: 18px 20px; width: 150px;">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="brand-row">
                                <td class="ps-4 align-middle">
                                    <span class="text-muted fw-bold" style="font-family: 'Montserrat', sans-serif;">#@item.Service_Id.ToString("D3")</span>
                                </td>
                                <td class="align-middle fw-semibold text-dark">@item.Service_Name</td>
                                <td class="align-middle text-end font-monospace" style="color: #FF9760; font-weight: 600;">@item.Price.ToString("N2")</td>

                                <td class="align-middle text-center">
                                    <div class="form-check form-switch d-inline-block">
                                        <input class="form-check-input toggle-status-btn" type="checkbox" role="switch"
                                               data-id="@item.Service_Id"
                                               data-name="@item.Service_Name"
                                        @(item.IsActive ? "checked" : "")
                                               style="cursor: pointer; width: 2.5em; height: 1.25em;">
                                    </div>
                                </td>

                                <td class="text-center pe-4 align-middle">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Service_Id" class="action-icon btn-edit" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #EAEAEA; color: #4A90E2; text-decoration: none;">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Service_Id" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-icon btn-delete" style="width: 38px; height: 38px; border-radius: 8px; border: 1px solid #EAEAEA; color: #E05638; background: white; cursor: pointer;"
                                                    onclick="return confirm('ยืนยันการลบบริการนี้?')">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">ไม่พบข้อมูลบริการในระบบ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .brand-row:hover {
        background-color: #FFF2EB !important;
    }

    .btn-edit:hover {
        background: #4A90E2;
        color: white !important;
    }

    .btn-delete:hover {
        background: #E05638;
        color: white !important;
    }

    .form-check-input:checked {
        background-color: #FF9760 !important;
        border-color: #FF9760 !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.toggle-status-btn').change(function () {
                var checkbox = $(this);
                var serviceId = checkbox.data('id');
                var serviceName = checkbox.data('name');
                var isChecked = checkbox.is(':checked');

                $.ajax({
                    // 🔥 ลิงก์ตรงหาหน้า AdminServicesController เพื่อยิงสลับสถานะ
                    url: '@Url.Action("ToggleStatus", "AdminServices")',
                    type: 'POST',
                    data: {
                        id: serviceId,
                        status: isChecked
                    },
                    success: function (response) {
                        if (response.success) {
                            if (isChecked) {
                                Swal.fire({
                                    title: 'เปิดบริการสำเร็จ',
                                    text: `"${serviceName}" พร้อมให้บริการแล้ว`,
                                    icon: 'success',
                                    confirmButtonColor: '#FF9760',
                                    timer: 2000
                                });
                            } else {
                                Swal.fire({
                                    title: 'ปิดบริการสำเร็จ',
                                    text: `"${serviceName}" ไม่พร้อมให้บริการ`,
                                    icon: 'warning',
                                    confirmButtonColor: '#FF9760',
                                    timer: 2000
                                });
                            }
                        } else {
                            checkbox.prop('checked', !isChecked);
                            Swal.fire({
                                title: 'เกิดข้อผิดพลาด',
                                text: response.message || 'ไม่สามารถอัปเดตสถานะได้',
                                icon: 'error',
                                confirmButtonColor: '#FF9760'
                            });
                        }
                    },
                    error: function () {
                        checkbox.prop('checked', !isChecked);
                        Swal.fire({
                            title: 'เกิดข้อผิดพลาด',
                            text: 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้',
                            icon: 'error',
                            confirmButtonColor: '#FF9760'
                        });
                    }
                });
            });
        });
    </script>
}   