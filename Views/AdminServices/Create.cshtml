@model CS66_WebApplication1.Models.Service

@{
    ViewData["Title"] = "เพิ่มบริการใหม่";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="brand-header shadow-sm" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFF2EB 100%); padding: 35px 40px; border-left: 6px solid #FF9760; border-radius: 12px; margin-bottom: 30px; border: 1px solid #EAEAEA;">
        <h2 class="fw-bold mb-0">ลงทะเบียน<span style="color: #FF9760;">บริการใหม่</span></h2>
        <p class="text-muted small mt-2 mb-0">กรอกรายละเอียดเพื่อเพิ่มรายการบริการใหม่เข้าสู่ระบบ</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card lux-card shadow-sm" style="border: 1px solid #EAEAEA; border-radius: 12px; padding: 40px; background: #FFFFFF;">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Service_Name" class="form-label fw-bold">ชื่อบริการ</label>
                        <input asp-for="Service_Name" class="form-control form-control-lg" placeholder="เช่น บริการเปลี่ยนถ่ายน้ำมันเครื่อง..." style="border-radius: 8px; border: 1px solid #EAEAEA; padding: 12px;" required />
                        <span asp-validation-for="Service_Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Price" class="form-label fw-bold">ราคา (บาท)</label>
                            <input asp-for="Price" type="number" step="0.01" class="form-control form-control-lg" placeholder="0.00" style="border-radius: 8px; border: 1px solid #EAEAEA; padding: 12px;" required />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">รายละเอียด</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="ใส่คำอธิบายเพิ่มเติมเกี่ยวกับบริการนี้..." style="border-radius: 8px; border: 1px solid #EAEAEA; padding: 12px;"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                            <i class="bi bi-x-circle me-1"></i> ยกเลิก
                        </a>
                        <button type="submit" class="btn btn-rim-orange px-4 py-2 rounded-pill" style="background: #FF9760; color: white; border: none;">
                            <i class="bi bi-check-lg me-1"></i> บันทึกข้อมูล
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}