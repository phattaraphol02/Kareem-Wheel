@model CS66_WebApplication1.Models.Customer
@{
    ViewData["Title"] = "แก้ไขข้อมูลผู้ใช้งาน";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;700;900&family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
<style>
    :root {
        --rim-orange: #FF9760;
        --rim-border: #eef0f2;
    }

    body {
        font-family: 'Roboto', sans-serif;
        background-color: #FDFDFD;
    }

    .edit-wrapper {
        max-width: 800px;
        margin: 40px auto;
    }

    .main-form-card {
        border: 1px solid var(--rim-border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 15px 40px rgba(255, 151, 96, 0.06);
        padding: 40px;
    }

    .title-large {
        font-family: 'Montserrat', sans-serif;
        font-weight: 900;
        text-transform: uppercase;
        margin-bottom: 25px;
    }

        .title-large span {
            color: var(--rim-orange);
        }

    .field-label {
        font-family: 'Montserrat', sans-serif;
        font-size: 0.75rem;
        color: #777;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: block;
        font-weight: 700;
    }

    .modern-input {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 15px;
        height: 50px;
        transition: 0.3s;
    }

        .modern-input:focus {
            border-color: var(--rim-orange);
            box-shadow: 0 0 10px rgba(255, 151, 96, 0.15);
            outline: none;
        }

    .btn-save {
        background: var(--rim-orange);
        color: white;
        border-radius: 30px;
        padding: 16px;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        transition: 0.3s;
        border: none;
    }

        .btn-save:hover {
            background: #f38349;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(255, 151, 96, 0.35);
        }
</style>

<div class="container edit-wrapper">
    <div class="main-form-card animate__animated animate__fadeInUp">
        <h1 class="title-large">Edit <span>Account</span></h1>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Customer_Id" />

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="field-label">ชื่อ-นามสกุล</label>
                    <input asp-for="Customer_Name" class="form-control modern-input" required />
                </div>
                <div class="col-md-6">
                    <label class="field-label">อีเมล</label>
                    <input asp-for="Customer_Email" class="form-control modern-input" type="email" required />
                </div>

                <div class="col-md-6">
                    <label class="field-label">เบอร์โทร</label>
                    <input asp-for="Phone" class="form-control modern-input" />
                </div>
                <div class="col-md-6">
                    <label class="field-label">Role</label>
                    <select asp-for="Role" class="form-select modern-input">
                        <option value="1">1 - ลูกค้า (Customer)</option>
                        <option value="2">2 - พนักงาน (Staff)</option>
                        <option value="9">9 - ผู้ดูแลระบบ (Admin)</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="field-label">จังหวัด</label>
                    <select asp-for="Province_Id" class="form-select modern-input" id="provinceDropdown">
                        <option value="">SELECT PROVINCE</option>
                        @foreach (var p in (List<CS66_WebApplication1.Models.Province>)ViewBag.Provinces)
                        {
                            <option value="@p.Province_Id" selected="@(Model.Province_Id == p.Province_Id)">
                                @p.Province_Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="field-label">อำเภอ</label>
                    <select asp-for="Amphur_Id" class="form-select modern-input" id="amphurDropdown">
                        <option value="">SELECT DISTRICT</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="field-label">ตำบล</label>
                    <select asp-for="District_Id" class="form-select modern-input" id="districtDropdown">
                        <option value="">SELECT SUB-DISTRICT</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="field-label">รหัสไปรษณีย์</label>
                    <input asp-for="PostalCode" class="form-control modern-input" id="postalCode" />
                </div>

                <div class="col-12">
                    <label class="field-label">ที่อยู่</label>
                    <textarea asp-for="Address" class="form-control modern-input" style="height:auto;"></textarea>
                </div>

                <div class="col-12">
                    <label class="field-label">New Password (ปล่อยว่างไว้หากใช้รหัสเดิม)</label>
                    <input name="Password" id="Password" class="form-control modern-input" type="password" placeholder="ระบุหากต้องการเปลี่ยนรหัสผ่าน..." autocomplete="new-password" />
                </div>
            </div>

            <button type="submit" class="btn btn-save w-100 mt-4">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2 border-0 fw-bold" style="font-family:'Montserrat', sans-serif;">CANCEL</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // ดึงค่ามาจาก C# (ใช้เงื่อนไขเช็ก null ป้องกัน Error และแปลงเป็น String ให้ตรงกับรูปแบบ value ของ option)
            var currentProvinceId = '@(Model.Province_Id != null ? Model.Province_Id.ToString() : "")';
            var currentAmphurId = '@(Model.Amphur_Id != null ? Model.Amphur_Id.ToString() : "")';
            var currentDistrictId = '@(Model.District_Id != null ? Model.District_Id.ToString() : "")';

            // 1. โหลดข้อมูลเริ่มต้นเมื่อเข้าหน้า
            if (currentProvinceId && currentProvinceId !== "0") {
                loadAmphurs(currentProvinceId, currentAmphurId, currentDistrictId);
            }

            // 2. เมื่อผู้ใช้เปลี่ยน "จังหวัด"
            $('#provinceDropdown').change(function() {
                loadAmphurs($(this).val(), null, null);
                $('#districtDropdown').empty().append('<option value="">SELECT SUB-DISTRICT</option>');
                $('#postalCode').val('');
            });

            // 3. เมื่อผู้ใช้เปลี่ยน "อำเภอ"
            $('#amphurDropdown').change(function() {
                loadDistricts($(this).val(), null);
                $('#postalCode').val('');
            });

            // 4. เมื่อผู้ใช้เปลี่ยน "ตำบล" ให้อัปเดตรหัสไปรษณีย์
            $('#districtDropdown').change(function() {
                $('#postalCode').val($(this).find(':selected').data('postcode'));
            });

            // --- ฟังก์ชันโหลดอำเภอ ---
            function loadAmphurs(pId, selectedAmphurId, selectedDistrictId) {
                if (!pId) return;

                $.getJSON('@Url.Action("GetAmphurs", "AdminUsers")', { provinceId: pId }, function(data) {
                    var dd = $('#amphurDropdown');
                    dd.empty().append('<option value="">SELECT DISTRICT</option>');

                    $.each(data, function(i, a) {
                        var val = a.amphur_Id || a.value || a.id;
                        var text = a.amphur_Name || a.text || a.name;

                        if(val !== undefined && val !== null) {
                            dd.append('<option value="' + val.toString() + '">' + text + '</option>');
                        }
                    });

                    // ใช้คำสั่ง .val() หลังจาก append เสร็จแล้ว จะชัวร์ที่สุดว่า Option ถูกเลือก
                    if (selectedAmphurId && selectedAmphurId !== "0") {
                        dd.val(selectedAmphurId);
                        // โหลดตำบลต่อ
                        loadDistricts(selectedAmphurId, selectedDistrictId);
                    }
                });
            }

            // --- ฟังก์ชันโหลดตำบล ---
            function loadDistricts(aId, selectedDistrictId) {
                if (!aId) return;

                $.getJSON('@Url.Action("GetDistrictsByAmphur", "District")', { amphurId: aId }, function(data) {
                    var dd = $('#districtDropdown');
                    dd.empty().append('<option value="">SELECT SUB-DISTRICT</option>');

                    $.each(data, function(i, item) {
                        var val = item.value || item.district_Id || item.id;
                        var text = item.text || item.district_Name || item.name;
                        var pc = item.postCode || item.postalCode || '';

                        if(val !== undefined && val !== null) {
                            dd.append('<option value="' + val.toString() + '" data-postcode="' + pc + '">' + text + '</option>');
                        }
                    });

                    // ใช้คำสั่ง .val() หลังจาก append เสร็จแล้ว
                    if (selectedDistrictId && selectedDistrictId !== "0") {
                        dd.val(selectedDistrictId);
                    }
                });
            }
        });
    </script>
}