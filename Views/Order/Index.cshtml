@model List<Product>

@{
    ViewData["Title"] = "ระบบจัดการคลังสินค้า";
    int totalItems = ViewBag.TotalItems ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB; /* สีส้มพาสเทลสว่าง */
        --rim-orange-hover: #f38349;
        --rim-bg-light: #F9FAFB; /* พื้นหลังเว็บสีขาวสว่าง */
        --rim-card: #FFFFFF; /* พื้นหลังการ์ดขาวล้วน */
        --rim-text-main: #2D2D2D; /* สีตัวอักษรหลัก */
        --rim-text-muted: #7A7A7A; /* สีตัวอักษรรอง */
        --rim-border: #EAEAEA; /* สีเส้นขอบเทาอ่อน */
    }

    body {
        background-color: var(--rim-bg-light);
        font-family: 'Kanit', sans-serif;
        color: var(--rim-text-main);
    }

    /* Header Styling - ไล่เฉดสว่าง ขาว-ส้มพาสเทล ขอบซ้ายส้มเด่นชัด */
    .page-header-rim {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        color: var(--rim-text-main);
        padding: 35px 40px;
        border-left: 6px solid var(--rim-orange);
        border-radius: 12px;
        margin-bottom: 30px;
        border-top: 1px solid var(--rim-border);
        border-right: 1px solid var(--rim-border);
        border-bottom: 1px solid var(--rim-border);
    }

    /* Stats Cards - โค้งมน คลีนสะอาดตา */
    .stat-card-lux {
        background: var(--rim-card);
        border: 1px solid var(--rim-border);
        border-radius: 12px;
        padding: 22px 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.01);
        transition: 0.3s;
    }

    .stat-label {
        font-size: 0.8rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--rim-text-muted);
        display: block;
        margin-bottom: 6px;
    }

    .stat-value {
        font-family: 'Montserrat', sans-serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--rim-text-main);
    }

    /* Table & Container Card Customization */
    .inventory-card {
        border: 1px solid var(--rim-border);
        border-radius: 12px;
        background: var(--rim-card);
        box-shadow: 0 8px 25px rgba(0,0,0,0.01);
        overflow: hidden;
    }

    .lux-table thead th {
        background: #FAFAFA;
        color: var(--rim-text-main);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 18px 20px;
        border-bottom: 2px solid var(--rim-border);
    }

    .lux-table tbody td {
        padding: 15px 20px;
        vertical-align: middle;
        border-bottom: 1px solid #F5F5F5;
        font-size: 0.95rem;
    }

    .product-row {
        transition: 0.2s;
    }

        .product-row:hover {
            background-color: var(--rim-orange-light) !important;
        }

    /* Product Image Container */
    .product-img-container {
        width: 52px;
        height: 52px;
        border: 1px solid var(--rim-border);
        border-radius: 8px;
        padding: 2px;
        background: white;
        overflow: hidden;
    }

    /* Action Buttons */
    .btn-rim-orange {
        background: var(--rim-orange);
        color: white;
        border: none;
        border-radius: 30px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-rim-orange:hover {
            background: var(--rim-orange-hover);
            color: white;
            box-shadow: 0 4px 12px rgba(255, 151, 96, 0.3);
        }

    .btn-rim-outline-orange {
        background: transparent;
        color: var(--rim-orange);
        border: 1px solid var(--rim-orange);
        border-radius: 30px;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-rim-outline-orange:hover {
            background: var(--rim-orange-light);
            color: var(--rim-orange-hover);
            border-color: var(--rim-orange-hover);
        }

    /* Action Links (แก้ไข / ลบ) */
    .action-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid var(--rim-border);
        transition: 0.2s;
        background: #FFFFFF;
        text-decoration: none;
        font-size: 0.9rem;
    }

    .btn-edit {
        color: #4A90E2;
    }

        .btn-edit:hover {
            background: #4A90E2;
            color: white;
            border-color: #4A90E2;
        }

    .btn-delete {
        color: #E05638;
    }

        .btn-delete:hover {
            background: #E05638;
            color: white;
            border-color: #E05638;
        }
</style>

<div class="container-fluid px-lg-5 py-4">
    <div class="page-header-rim shadow-sm">
        <div class="row align-items-center">
            <div class="col-xl-6 col-md-5">
                <p class="text-muted small mb-1 text-uppercase fw-semibold" style="letter-spacing: 2px;">ระบบบริหารจัดการข้อมูลภายใน</p>
                <h2 class="fw-bold mb-0">ระบบจัดการ<span style="color: var(--rim-orange)">คลังสินค้า</span></h2>
            </div>
            <div class="col-xl-6 col-md-7 text-md-end mt-3 mt-md-0">
                <a class="btn btn-outline-secondary rounded-pill me-2 px-4 py-2" asp-controller="AdminDashboard" asp-action="Index">
                    <i class="bi bi-arrow-left-short"></i> แดชบอร์ด
                </a>
                <a class="btn btn-rim-outline-orange rounded-pill me-2 px-4 py-2" asp-controller="Brand" asp-action="Index">
                    <i class="bi bi-tags me-1"></i> จัดการแบรนด์สินค้า
                </a>
                <a class="btn btn-rim-orange px-4 py-2" asp-action="Create">
                    <i class="bi bi-plus-lg me-1"></i> เพิ่มสินค้าใหม่เข้าคลัง
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="stat-card-lux">
                <span class="stat-label">รายการสินค้าทั้งหมด</span>
                <div class="stat-value" style="font-family: 'Kanit', sans-serif;">
                    @totalItems <span class="fs-6 text-muted fw-normal">รายการ</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-lux">
                <span class="stat-label">แบรนด์สินค้าในคลัง</span>
                <div class="stat-value">
                    @(Model?.Select(p => p.Brand_Id).Distinct().Count() ?? 0)
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card-lux">
                <span class="stat-label">ราคาประเมินเฉลี่ยต่อชิ้น</span>
                <div class="stat-value" style="color: var(--rim-orange); font-family: 'Kanit', sans-serif;">
                    ฿@(Model != null && Model.Any() ? Model.Average(p => p.Price).ToString("N0") : "0")
                </div>
            </div>
        </div>
    </div>

    <div class="card inventory-card">
        <div class="table-responsive">
            <table class="table lux-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" width="130">รหัสสินค้า</th>
                        <th>ข้อมูลรายการสินค้า / วันที่เพิ่ม</th>
                        <th class="text-center">แบรนด์สินค้า</th>
                        <th class="text-end" width="180">ราคาต่อหน่วย</th>
                        <th class="text-center pe-4" width="160">การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted mb-0 py-3">
                                    <i class="bi bi-box-seam fs-2 d-block mb-2 text-opacity-50"></i>
                                    ยังไม่มีข้อมูลสินค้าในระบบคลังปัจจุบัน
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="product-row">
                                <td class="ps-4">
                                    <span class="text-muted fw-bold" style="font-family: 'Montserrat', sans-serif; font-size: 0.85rem;">#@item.Product_Id.ToString("D4")</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="product-img-container me-3 shadow-sm">
                                            @{
                                                var imageSrc = item.ImageFileName?.StartsWith("http") == true
                                                ? item.ImageFileName
                                                : "/Products/" + (string.IsNullOrEmpty(item.ImageFileName) ? "default.jpg" : item.ImageFileName);
                                            }
                                            <img src="@imageSrc" class="w-100 h-100 object-fit-cover rounded"
                                                 onerror="this.src='https://placehold.co/100x100?text=No+Img'" />
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark text-uppercase mb-0" style="font-size: 0.95rem;">@item.Product_Name</div>
                                            <div class="text-muted small" style="font-size: 0.75rem;">
                                                <i class="bi bi-clock-history me-1"></i>นำเข้าเมื่อ: @item.CreateAt.ToString("dd MMM yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge px-3 py-2 text-uppercase" style="font-size: 0.75rem; font-weight: 500; background: #FFF2EB; color: #E86E2F; border-radius: 6px;">
                                        @(item.Brand?.Brand_Name ?? "Unbranded")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold" style="color: #2D2D2D; font-family: 'Montserrat', sans-serif;">฿@item.Price.ToString("N0")</span>
                                </td>
                                <td class="pe-4 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Product_Id" class="action-icon btn-edit" title="แก้ไขสินค้า">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a href="javascript:void(0)" onclick="prepareDelete('@item.Product_Id')" class="action-icon btn-delete" title="ลบสินค้า">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius: 16px; box-shadow: 0 15px 40px rgba(0,0,0,0.1);">
            <div class="modal-body p-5 text-center">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: #FDF3F1; color: #E05638; border-radius: 50%;">
                    <i class="bi bi-exclamation-octagon fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">ยืนยันการนำสินค้าออก?</h4>
                <p class="text-muted small mb-4">คุณแน่ใจหรือไม่ว่าต้องการลบรายการสินค้านี้ออกจากคลังข้อมูลหลัก? เมื่อกดยืนยันแล้วข้อมูลชิ้นนี้จะไม่สามารถกู้คืนกลับมาได้อีก</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4 py-2 fw-medium" data-bs-dismiss="modal" style="border: 1px solid #ddd;">ยกเลิก</button>
                    <form method="post" asp-action="Delete">
                        <input type="hidden" name="id" id="deleteProductId" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-medium">ยืนยันถอนสินค้า</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function prepareDelete(id) {
            document.getElementById('deleteProductId').value = id;
            new bootstrap.Modal(document.getElementById('deleteProductModal')).show();
        }
    </script>
}