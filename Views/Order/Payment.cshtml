@model CS66_WebApplication1.Models.Order

@{
    ViewData["Title"] = "Secure Payment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">

<style>
    :root {
        --lux-gold: #c5a059;
        --lux-gold-dark: #a68549;
        --lux-dark: #1a1a1a;
        --lux-gray: #888888;
        --lux-border: #eeeeee;
        --lux-bg: #fcfcfc;
    }

    body {
        background-color: var(--lux-bg);
        font-family: 'Montserrat', sans-serif;
    }

    .payment-container {
        max-width: 550px;
        margin: 60px auto;
    }

    .lux-card {
        background: white;
        border: 1px solid var(--lux-border);
        border-radius: 0; /* Luxury มักจะใช้ทรงเหลี่ยม */
        box-shadow: 0 15px 40px rgba(0,0,0,0.03);
        padding: 40px;
    }

    .page-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.2rem;
        color: var(--lux-dark);
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .gold-divider {
        width: 50px;
        height: 2px;
        background: var(--lux-gold);
        margin: 20px auto 30px;
    }

    .order-ref {
        font-size: 0.8rem;
        letter-spacing: 1.5px;
        color: var(--lux-gray);
        text-transform: uppercase;
        text-align: center;
        margin-bottom: 5px;
    }

    .amount-display {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.8rem;
        font-weight: 700;
        color: var(--lux-gold-dark);
        text-align: center;
        margin-bottom: 40px;
    }

    .qr-section {
        background-color: #fdfdfd;
        border: 1px solid #f0f0f0;
        padding: 30px;
        text-align: center;
        margin-bottom: 30px;
    }

    .qr-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--lux-gray);
        margin-bottom: 15px;
        display: block;
    }

    .qr-image {
        max-width: 180px;
        filter: grayscale(0.2);
        transition: 0.3s;
    }

        .qr-image:hover {
            filter: grayscale(0);
            transform: scale(1.02);
        }

    /* Form Styling */
    .lux-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--lux-dark);
        font-weight: 600;
        margin-bottom: 10px;
    }

    .form-control-lux {
        border-radius: 0;
        border: 1px solid var(--lux-border);
        padding: 12px;
        font-size: 0.9rem;
    }

        .form-control-lux:focus {
            border-color: var(--lux-gold);
            box-shadow: none;
        }

    .btn-lux-confirm {
        background: var(--lux-dark);
        color: white;
        border: 1px solid var(--lux-dark);
        border-radius: 0;
        padding: 15px;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 2px;
        font-weight: 600;
        width: 100%;
        transition: 0.4s;
        margin-top: 20px;
    }

        .btn-lux-confirm:hover {
            background: transparent;
            color: var(--lux-dark);
        }

    .footer-note {
        font-size: 0.75rem;
        color: var(--lux-gray);
        text-align: center;
        margin-top: 25px;
        font-style: italic;
    }
</style>

<div class="container">
    <div class="payment-container">
        <div class="lux-card">

            <div class="order-ref">Reference Order</div>
            <h3 class="page-title">Payment Transfer</h3>
            <div class="gold-divider"></div>

            <div class="text-center mb-1">
                <span class="text-muted small">Invoice No. #@Model.Order_Id.ToString("D5")</span>
            </div>

            <div class="amount-display">
                <span style="font-size: 1.5rem; font-weight: 400; margin-right: 5px;">฿</span>@Model.GrandTotal.ToString("N2")
            </div>

            <div class="qr-section">
                <span class="qr-label">Official PromptPay QR</span>
                <img src="~/images/promptpay.png" alt="PromptPay" class="qr-image" />
                <p class="mt-3 mb-0 small text-muted">Scan to complete transaction</p>
            </div>

            <form asp-action="UploadSlip" method="post" enctype="multipart/form-data">
                <input type="hidden" name="orderId" value="@Model.Order_Id" />

                <div class="mb-4">
                    <label class="lux-label d-block">
                        <i class="bi bi-upload me-2"></i> Proof of Transfer (Slip)
                    </label>
                    <input type="file" name="slip" class="form-control form-control-lux" required />
                </div>

                <button type="submit" class="btn btn-lux-confirm">
                    Complete Purchase
                </button>
            </form>

            <div class="footer-note">
                Our curators will verify your transaction within 24 hours. <br>
                Thank you for choosing our excellence.
            </div>

        </div>
    </div>
</div>