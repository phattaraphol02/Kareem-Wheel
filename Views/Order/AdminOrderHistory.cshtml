@using CS66_WebApplication1.Models
@model List<Order>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    string currentStatus = ViewBag.CurrentStatus ?? "All";
    int pendingVerifyCount = ViewBag.PendingVerifyCount ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700;900&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB;
        --rim-orange-hover: #f38349;
        --rim-bg-light: #F9FAFB;
        --rim-card: #FFFFFF;
        --rim-text-main: #2D2D2D;
        --rim-text-muted: #7A7A7A;
        --rim-border: #EAEAEA;
    }

    body { background-color: var(--rim-bg-light); font-family: 'Kanit', sans-serif; color: var(--rim-text-main); }

    .page-header-rim {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        padding: 30px 35px; border-radius: 16px; margin-bottom: 25px;
        border: 1px solid var(--rim-border); display: flex; align-items: center; gap: 15px;
    }
    .header-icon {
        width: 50px; height: 50px; background: var(--rim-orange); color: white;
        border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; box-shadow: 0 4px 15px rgba(255,151,96,0.3);
    }

    .btn-rim-filter {
        border: 1px solid var(--rim-border); background: #FFF; color: var(--rim-text-muted);
        font-size: 0.85rem; font-weight: 500; padding: 8px 20px; border-radius: 30px;
        transition: all 0.25s; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-rim-filter:hover, .btn-rim-filter.active {
        background: var(--rim-orange); color: white; border-color: var(--rim-orange);
        box-shadow: 0 4px 12px rgba(255,151,96,0.25); transform: translateY(-1px);
    }
    .filter-badge {
        background: #E53935; color: white; font-size: 0.7rem; padding: 2px 7px;
        border-radius: 20px; font-weight: 700; min-width: 20px; text-align: center;
    }
    .btn-rim-filter.active .filter-badge { background: white; color: var(--rim-orange); }

    .search-box { max-width: 300px; position: relative; }
    .search-box i { position: absolute; top: 50%; left: 15px; transform: translateY(-50%); color: #A0A0A0; }
    .search-box input {
        border: 1px solid var(--rim-border); border-radius: 30px; padding: 8px 18px 8px 40px;
        font-size: 0.9rem; width: 100%;
    }
    .search-box input:focus { border-color: var(--rim-orange); outline: none; box-shadow: 0 0 0 3px rgba(255,151,96,0.1); }

    .lux-card { border: 1px solid var(--rim-border); border-radius: 16px; background: var(--rim-card); box-shadow: 0 8px 25px rgba(0,0,0,0.03); overflow: hidden; }
    .lux-table { margin-bottom: 0; }
    .lux-table thead th { background: #FAFAFA; padding: 15px 20px; border-bottom: 2px solid var(--rim-border); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #555; }
    .lux-table tbody td { padding: 16px 20px; vertical-align: middle; border-bottom: 1px solid #F8F9FA; font-size: 0.9rem; }
    .order-row { transition: background-color 0.2s; }
    .order-row:hover { background-color: var(--rim-orange-light) !important; }

    .badge-lux { font-size: 0.78rem; font-weight: 600; padding: 6px 14px; border-radius: 30px; display: inline-flex; align-items: center; gap: 5px; }
    .status-verify { background: #FFF3E0; color: #E65100; }
    .status-pending { background: #FFF8E1; color: #F57F17; }
    .status-processing { background: #E8EAF6; color: #3949AB; }
    .status-shipped { background: #E3F2FD; color: #1976D2; }
    .status-delivered { background: #E8F5E9; color: #2E7D32; }
    .status-default { background: #F5F5F5; color: #616161; }

    .btn-action { font-size: 0.8rem; font-weight: 600; border-radius: 8px; padding: 6px 14px; transition: all 0.2s; border: none; }
    .btn-verify { background: #4CAF50; color: white; }
    .btn-verify:hover { background: #388E3C; color: white; }
    .btn-ship { background: var(--rim-orange); color: white; }
    .btn-ship:hover { background: var(--rim-orange-hover); color: white; }
    .btn-view { color: var(--rim-orange); border: 1.5px solid var(--rim-orange); background: transparent; }
    .btn-view:hover { background: var(--rim-orange); color: white; }

    .slip-thumb { width: 40px; height: 40px; object-fit: cover; border-radius: 6px; border: 1px solid #ddd; cursor: pointer; }

</style>

<div class="container-fluid px-lg-5 py-4">

    <div class="page-header-rim shadow-sm">
        <div class="header-icon"><i class="bi bi-receipt"></i></div>
        <div>
            <h2 class="fw-bold mb-1" style="font-family: 'Montserrat', sans-serif;">จัดการ<span style="color: var(--rim-orange)">คำสั่งซื้อ</span></h2>
            <p class="text-muted mb-0" style="font-size: 0.9rem;">ตรวจสอบสลิป อัปเดตสถานะ และจัดการจัดส่ง</p>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a class="btn-rim-filter @(currentStatus == "All" ? "active" : "")" asp-action="AdminOrderHistory" asp-route-status="All">ทั้งหมด</a>
            <a class="btn-rim-filter @(currentStatus == "PendingVerify" ? "active" : "")" asp-action="AdminOrderHistory" asp-route-status="PendingVerify">
                <i class="bi bi-credit-card-2-back"></i> รอยืนยันสลิป
                @if (pendingVerifyCount > 0)
                {
                    <span class="filter-badge">@pendingVerifyCount</span>
                }
            </a>
            <a class="btn-rim-filter @(currentStatus == "Processing" ? "active" : "")" asp-action="AdminOrderHistory" asp-route-status="Processing">เตรียมสินค้า</a>
            <a class="btn-rim-filter @(currentStatus == "Shipped" ? "active" : "")" asp-action="AdminOrderHistory" asp-route-status="Shipped">กำลังจัดส่ง</a>
            <a class="btn-rim-filter @(currentStatus == "Delivered" ? "active" : "")" asp-action="AdminOrderHistory" asp-route-status="Delivered">ส่งสำเร็จ</a>
        </div>
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" placeholder="ค้นหาออเดอร์ / ชื่อลูกค้า..." onkeyup="filterTable()">
        </div>
    </div>

    <div class="lux-card">
        <div class="table-responsive">
            <table class="table lux-table align-middle" id="orderTable">
                <thead>
                    <tr>
                        <th class="text-center" style="width:10%;">ออเดอร์</th>
                        <th style="width:18%;">ลูกค้า</th>
                        <th class="text-center" style="width:10%;">ยอดเงิน</th>
                        <th style="width:15%;">สถานะ</th>
                        <th style="width:12%;">สลิป</th>
                        <th style="width:15%;">เลข Tracking</th>
                        <th class="text-center" style="width:20%;">จัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string badgeClass = "status-default";
                            string statusText = "อื่นๆ";
                            string statusIcon = "bi-record-circle";
                            string itemStatus = item.Status ?? "";

                            if (itemStatus == "PendingVerify") { badgeClass = "status-verify"; statusText = "รอยืนยันสลิป"; statusIcon = "bi-credit-card-2-back"; }
                            else if (itemStatus == "Processing") { badgeClass = "status-processing"; statusText = "เตรียมสินค้า"; statusIcon = "bi-box-seam"; }
                            else if (itemStatus == "Shipped") { badgeClass = "status-shipped"; statusText = "กำลังจัดส่ง"; statusIcon = "bi-truck"; }
                            else if (itemStatus == "Delivered" || itemStatus == "Completed") { badgeClass = "status-delivered"; statusText = "ส่งสำเร็จ"; statusIcon = "bi-check-circle-fill"; }
                            else if (itemStatus == "Pending" || itemStatus == "New") { badgeClass = "status-pending"; statusText = "รอชำระเงิน"; statusIcon = "bi-hourglass-split"; }

                            <tr class="order-row">
                                <td class="text-center fw-bold" style="font-family:'Montserrat',sans-serif;">@(item.OrderNumber ?? $"ORD{item.Order_Id:D4}")</td>
                                <td>
                                    <div class="fw-bold">@(item.Customer?.Customer_Name ?? "ลูกค้าทั่วไป")</div>
                                    <small class="text-muted">@item.OrderDate.ToString("dd/MM/yy HH:mm")</small>
                                </td>
                                <td class="text-center fw-bold" style="color: var(--rim-orange);">฿@item.GrandTotal.ToString("N0")</td>
                                <td><span class="badge-lux @badgeClass"><i class="bi @statusIcon"></i> @statusText</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.SlipImage))
                                    {
                                        <a href="/slips/@item.SlipImage" target="_blank">
                                            <img src="/slips/@item.SlipImage" class="slip-thumb" alt="slip" />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td style="font-family:'Montserrat',sans-serif; font-weight:500; color:#555;">
                                    @if (!string.IsNullOrEmpty(item.ShippingCompany))
                                    {
                                        <small class="d-block text-muted" style="font-size:0.72rem;">@item.ShippingCompany</small>
                                    }
                                    @(string.IsNullOrEmpty(item.TrackingNo) ? "-" : item.TrackingNo)
                                </td>
                                <td class="text-center">
                                    @if (itemStatus == "PendingVerify")
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Order_Id" class="btn btn-action btn-verify">
                                            <i class="bi bi-check-lg"></i> ตรวจสอบสลิป
                                        </a>
                                    }
                                    else if (itemStatus == "Processing")
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Order_Id" class="btn btn-action btn-ship">
                                            <i class="bi bi-truck"></i> กรอกเลขพัสดุ
                                        </a>
                                    }
                                    else if (itemStatus == "Shipped")
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Order_Id" class="btn btn-action btn-verify">
                                            <i class="bi bi-check-all"></i> ยืนยันส่งสำเร็จ
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Order_Id" class="btn btn-action btn-view">
                                            <i class="bi bi-eye"></i> ดูรายละเอียด
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-3" style="color:#EAEAEA;"></i>
                                <h5 class="fw-bold">ไม่พบรายการ</h5>
                                <p class="text-muted mb-0">ยังไม่มีรายการคำสั่งซื้อในหมวดหมู่นี้</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            let input = document.getElementById("searchInput").value.toLowerCase();
            let rows = document.querySelectorAll("#orderTable tbody .order-row");
            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(input) ? "" : "none";
            });
        }
    </script>
}
