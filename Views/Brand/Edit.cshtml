@model CS66_WebApplication1.Models.Brand

@{
    ViewData["Title"] = "Modify Brand - Kareem Admin";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB; /* สีส้มพาสเทลสว่าง */
        --rim-orange-hover: #f38349;
        --rim-bg-light: #F9FAFB; /* พื้นหลังเว็บสีขาวสว่าง */
        --rim-card: #FFFFFF; /* พื้นหลังการ์ดขาวล้วน */
        --rim-text-main: #2D2D2D; /* สีตัวอักษรหลัก */
        --rim-text-muted: #7A7A7A; /* สีตัวอักษรรอง */
        --rim-border: #EAEAEA; /* สีเส้นขอบเทาอ่อน */
    }

    body {
        background-color: var(--rim-bg-light);
        font-family: 'Kanit', sans-serif;
        color: var(--rim-text-main);
    }

    /* Header Styling - ไล่เฉดสว่าง ขาว-ส้มพาสเทล ขอบซ้ายส้มเด่นชัดสไตล์ระบบจัดการคลัง */
    .page-header-rim {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        color: var(--rim-text-main);
        padding: 35px 40px;
        border-left: 6px solid var(--rim-orange);
        border-radius: 12px;
        margin-bottom: 35px;
        border-top: 1px solid var(--rim-border);
        border-right: 1px solid var(--rim-border);
        border-bottom: 1px solid var(--rim-border);
    }

    /* Breadcrumb Customization */
    .rim-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
        color: var(--rim-text-muted);
    }

    /* Card Styling - ขอบมน พรีเมียม คลีนนุ่มนวล */
    .lux-form-card {
        border: 1px solid var(--rim-border);
        border-radius: 12px;
        background: var(--rim-card);
        box-shadow: 0 8px 25px rgba(0,0,0,0.01);
    }

    /* Inputs - ปรับจากเหลี่ยมคมเป็นโค้งมนมนพรีเมียม */
    .label-accent {
        color: var(--rim-text-main);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        display: block;
    }

    .custom-input {
        border: 1px solid var(--rim-border);
        background-color: #fff;
        border-radius: 8px;
        padding: 12px 16px;
        transition: 0.2s;
        font-size: 0.95rem;
    }

        .custom-input:focus {
            box-shadow: 0 0 0 3px rgba(255, 151, 96, 0.15);
            border-color: var(--rim-orange);
            background-color: #fff;
        }

    /* Readonly Input Styling */
    .readonly-input {
        background-color: #F4F5F7 !important;
        border-color: var(--rim-border) !important;
        color: var(--rim-text-muted);
        font-weight: 500;
    }

    /* Buttons - คุมโทนส้ม-ขาว มนกลมกลืน */
    .btn-rim-save {
        background: var(--rim-orange);
        color: white;
        padding: 12px 35px;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.2s;
        border: 1px solid var(--rim-orange);
    }

        .btn-rim-save:hover {
            background: var(--rim-orange-hover);
            color: white;
            box-shadow: 0 4px 12px rgba(255, 151, 96, 0.2);
        }

    .btn-rim-cancel {
        color: var(--rim-text-muted);
        font-weight: 500;
        font-size: 0.95rem;
        text-decoration: none;
        transition: 0.2s;
        padding: 12px 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
    }

        .btn-rim-cancel:hover {
            color: var(--rim-text-main);
            background: #F0F2F5;
        }
</style>

<div class="container-fluid px-lg-5 py-4">
    <div class="page-header-rim shadow-sm">
        <div class="row align-items-center">
            <div class="col-md-7">
                <nav aria-label="breadcrumb" class="rim-breadcrumb mb-2">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-muted text-decoration-none small text-uppercase fw-semibold" style="letter-spacing: 1.5px;">แบรนด์สินค้า</a></li>
                        <li class="breadcrumb-item active small text-uppercase fw-semibold" style="color: var(--rim-orange); letter-spacing: 1.5px;">แก้ไขข้อมูลอัตลักษณ์</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0">แก้ไขข้อมูล<span style="color: var(--rim-orange)">แบรนด์สินค้า (Brand)</span></h2>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                <a class="btn btn-outline-secondary rounded-pill px-4" asp-controller="Brand" asp-action="Index">
                    <i class="bi bi-arrow-left-short"></i> กลับสู่รายการแบรนด์
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">
            <div class="lux-form-card p-4 p-md-5">
                <form asp-action="Edit" asp-route-id="@Model.Brand_Id" method="post">

                    <div class="mb-4">
                        <label class="label-accent" asp-for="Brand_Id">รหัสอ้างอิงระบบ (Brand ID)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted" style="border-radius: 8px 0 0 8px; border-color: var(--rim-border);">#</span>
                            <input class="form-control custom-input readonly-input border-start-0"
                                   style="border-radius: 0 8px 8px 0;"
                                   asp-for="Brand_Id"
                                   readonly />
                        </div>
                        <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                            <i class="bi bi-info-circle me-1"></i> รหัสนี้สร้างขึ้นโดยระบบอัตโนมัติและไม่สามารถแก้ไขได้
                        </p>
                    </div>

                    <div class="mb-5">
                        <label class="label-accent" asp-for="Brand_Name">ชื่อแบรนด์สินค้า (Brand Name)</label>
                        <input class="form-control custom-input fw-semibold"
                               asp-for="Brand_Name"
                               placeholder="ตัวอย่างเช่น KAREEM WHEELS, COSMIS, RAYS" />
                        <span asp-validation-for="Brand_Name" class="text-danger small mt-2 d-block"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-4 border-top">
                        <a class="btn-rim-cancel" asp-controller="Brand" asp-action="Index">
                            <i class="bi bi-arrow-left me-2"></i>ย้อนกลับคลังแบรนด์
                        </a>
                        <button type="submit" class="btn btn-rim-save shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> อัปเดตข้อมูลแบรนด์
                        </button>
                    </div>
                </form>
            </div>

            <div class="mt-4 text-center">
                <p class="text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i> การเปลี่ยนแปลงชื่อแบรนด์จะมีผลกับรายการสินค้าทั้งหมดที่ผูกกับแบรนด์นี้ทันที
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}