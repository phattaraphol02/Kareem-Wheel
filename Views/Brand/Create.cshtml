@model CS66_WebApplication1.Models.Brand

@{
    ViewData["Title"] = "New Brand Registration - Kareem Admin";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600;700&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --rim-orange: #FF9760;
        --rim-orange-light: #FFF2EB; /* สีส้มพาสเทลสว่าง */
        --rim-orange-hover: #f38349;
        --rim-bg-light: #F9FAFB; /* พื้นหลังเว็บสีขาวสว่าง */
        --rim-card: #FFFFFF; /* พื้นหลังการ์ดขาวล้วน */
        --rim-text-main: #2D2D2D; /* สีตัวอักษรหลัก */
        --rim-text-muted: #7A7A7A; /* สีตัวอักษรรอง */
        --rim-border: #EAEAEA; /* สีเส้นขอบเทาอ่อน */
    }

    body {
        background-color: var(--rim-bg-light);
        font-family: 'Kanit', sans-serif;
        color: var(--rim-text-main);
    }

    /* Header Styling - ไล่เฉดสว่าง ขาว-ส้มพาสเทล พร้อมขอบซ้ายสีส้มซิกเนเจอร์ */
    .page-header-rim {
        background: linear-gradient(135deg, #FFFFFF 0%, var(--rim-orange-light) 100%);
        color: var(--rim-text-main);
        padding: 35px 40px;
        border-left: 6px solid var(--rim-orange);
        border-radius: 12px;
        margin-bottom: 35px;
        border-top: 1px solid var(--rim-border);
        border-right: 1px solid var(--rim-border);
        border-bottom: 1px solid var(--rim-border);
    }

    /* Breadcrumb Customization */
    .rim-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
        color: var(--rim-text-muted);
    }

    /* Card Styling - โค้งมน คลีน นุ่มพรีเมียม */
    .lux-register-card {
        border: 1px solid var(--rim-border);
        border-radius: 12px;
        background: var(--rim-card);
        box-shadow: 0 8px 25px rgba(0,0,0,0.01);
    }

    /* Input & Labels */
    .label-accent {
        color: var(--rim-text-main);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
        display: block;
    }

    .custom-input-lg {
        border: 1px solid var(--rim-border);
        background-color: #FAFAFA;
        border-radius: 8px;
        padding: 14px 18px;
        transition: 0.2s;
        font-size: 1rem;
    }

        .custom-input-lg:focus {
            background-color: #fff;
            border-color: var(--rim-orange);
            box-shadow: 0 0 0 3px rgba(255, 151, 96, 0.15);
            outline: none;
        }

    /* Buttons - มนกลมกลืนตามธีม */
    .btn-rim-create {
        background: var(--rim-orange);
        color: white;
        border: 1px solid var(--rim-orange);
        padding: 14px 0;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.2s;
        width: 100%;
    }

        .btn-rim-create:hover {
            background: var(--rim-orange-hover);
            color: white;
            box-shadow: 0 4px 12px rgba(255, 151, 96, 0.2);
        }

    .btn-rim-outline {
        border: 1px solid var(--rim-border);
        background: #FAFAFA;
        color: var(--rim-text-muted);
        padding: 14px 0;
        border-radius: 8px;
        font-weight: 500;
        transition: 0.2s;
        text-decoration: none;
        display: block;
        text-align: center;
        width: 100%;
    }

        .btn-rim-outline:hover {
            background: #F0F2F5;
            color: var(--rim-text-main);
        }

    /* Tip Box - เปลี่ยนจากขอบทองดุดันเป็นส้มพาสเทลซอฟต์นุ่มนวล */
    .elite-tip {
        background: var(--rim-orange-light);
        color: var(--rim-text-main);
        border-radius: 8px;
        border: 1px solid rgba(255, 151, 96, 0.2);
        padding: 1.25rem;
    }

    .btn-rim-back {
        color: var(--rim-text-muted);
        font-weight: 500;
        font-size: 0.9rem;
        text-decoration: none;
        transition: 0.2s;
        padding: 8px 16px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
    }

        .btn-rim-back:hover {
            color: var(--rim-text-main);
            background: #F0F2F5;
        }
</style>

<div class="container-fluid px-lg-5 py-4">
    <div class="page-header-rim shadow-sm">
        <div class="row align-items-center">
            <div class="col-md-7">
                <nav aria-label="breadcrumb" class="rim-breadcrumb mb-2">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-muted text-decoration-none small text-uppercase fw-semibold" style="letter-spacing: 1.5px;">แบรนด์สินค้า</a></li>
                        <li class="breadcrumb-item active small text-uppercase fw-semibold" style="color: var(--rim-orange); letter-spacing: 1.5px;">เพิ่มแบรนด์ใหม่</li>
                    </ol>
                </nav>
                <h2 class="fw-bold mb-0">เพิ่มแบรนด์<span style="color: var(--rim-orange)">สินค้าใหม่ (New Brand)</span></h2>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="Index">
                    <i class="bi bi-arrow-left-short"></i> กลับสู่รายการแบรนด์
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">

            <div class="lux-register-card p-4 p-md-5">
                <form asp-action="Create" method="post">

                    <div class="mb-5">
                        <label class="label-accent" asp-for="Brand_Name">ชื่อแบรนด์สินค้าอย่างเป็นทางการ (Brand Name)</label>
                        <div class="position-relative">
                            <input class="form-control custom-input-lg fw-semibold"
                                   asp-for="Brand_Name"
                                   placeholder="ระบุชื่อแบรนด์สินค้า เช่น COSMIS, RAYS, W-WORK..."
                                   autofocus />
                        </div>
                        <span asp-validation-for="Brand_Name" class="text-danger small mt-2 d-block"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <button type="submit" class="btn btn-rim-create shadow-sm">
                                <i class="bi bi-plus-circle me-1"></i> ยืนยันเพิ่มแบรนด์สินค้า
                            </button>
                        </div>
                        <div class="col-md-4">
                            <a class="btn btn-rim-outline" asp-action="Index">
                                ยกเลิก
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="mt-4 elite-tip shadow-sm">
                <div class="d-flex align-items-start">
                    <i class="bi bi-info-circle-fill me-3 mt-0.5" style="color: var(--rim-orange); font-size: 1.1rem;"></i>
                    <div>
                        <h6 class="fw-bold mb-1" style="font-size: 0.85rem; letter-spacing: 0.5px; color: var(--rim-orange-hover);">ข้อแนะนำการตั้งชื่อ (Naming Protocol)</h6>
                        <p class="mb-0 text-secondary small" style="line-height: 1.6; font-size: 0.825rem;">
                            ควรระบุชื่อแบรนด์ให้กระชับ ชัดเจน และไม่ซ้ำซ้อนกับแบรนด์ที่มีอยู่แล้วในระบบ โดยชื่อแบรนด์นี้จะไปปรากฏในตัวเลือกสินค้า หน้าแสดงรายละเอียดล้อแม็ก และใบเสร็จรับเงินของลูกค้า
                        </p>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" class="btn-rim-back">
                    <i class="bi bi-arrow-left me-2"></i>ย้อนกลับคลังแบรนด์สินค้า
                </a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}