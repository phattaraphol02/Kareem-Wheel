@model IEnumerable<CS66_WebApplication1.Models.Category>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Kanit:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<div class="container-fluid px-lg-5 py-4">
    <div class="brand-header shadow-sm" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFF2EC 100%); padding: 35px 40px; border-left: 6px solid #FF9259; border-radius: 12px; margin-bottom: 30px; border: 1px solid #EAEAEA;">
        <div class="row align-items-center">
            <div class="col-md-7">
                <p class="text-muted small mb-1 text-uppercase fw-semibold" style="letter-spacing: 2px;">บริการทะเบียนข้อมูลกลาง</p>
                <h2 class="fw-bold mb-0">ระบบจัดการ<span style="color: #FF9259;">ประเภทสินค้า</span></h2>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
               
                <a class="btn btn-rim-orange px-4 py-2" asp-action="Create" style="background: #FF9259; color: white; border-radius: 30px;">
                    <i class="bi bi-plus-lg me-1"></i> เพิ่มประเภทสินค้าใหม่
                </a>
            </div>
        </div>
    </div>

    <div class="card lux-card animate__animated animate__fadeInUp" style="border: 1px solid #EAEAEA; border-radius: 12px; background: #FFFFFF; overflow: hidden;">
        <div class="card-header bg-white py-4 px-4 border-bottom-0">
            <h5 class="mb-0 fw-semibold" style="font-size: 1.05rem;">ทำเนียบรายการประเภทสินค้าทั้งหมด</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background: #FAFAFA;">
                    <tr>
                        <th class="ps-4" width="150" style="font-size: 0.85rem; padding: 18px 20px;">ID</th>
                        <th style="font-size: 0.85rem; padding: 18px 20px;">ชื่อประเภทสินค้า</th>
                        <th class="pe-4 text-end" width="200" style="font-size: 0.85rem; padding: 18px 20px;">จัดการข้อมูล</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="brand-row" style="transition: 0.2s;">
                                <td class="ps-4 align-middle">
                                    <span class="text-muted fw-bold" style="font-family: 'Montserrat', sans-serif;">#@item.Category_Id.ToString("D3")</span>
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="category-avatar me-3">
                                            @(string.IsNullOrWhiteSpace(item.Category_Name) ? "?" : item.Category_Name.Trim().Substring(0, 1).ToUpper())
                                        </div>
                                        <div class="fw-semibold text-dark text-uppercase" style="letter-spacing: 0.5px;">@item.Category_Name</div>
                                    </div>
                                </td>
                                <td class="pe-4 text-end align-middle">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Category_Id" class="action-icon btn-edit" style="width: 38px; height: 38px; display: inline-flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #EAEAEA; color: #4A90E2; text-decoration: none;">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Category_Id" method="post" style="display:inline;">
                                            <button type="submit" class="action-icon btn-delete" style="width: 38px; height: 38px; border-radius: 8px; border: 1px solid #EAEAEA; color: #E05638; background: white; cursor: pointer;"
                                                    onclick="return confirm('คุณแน่ใจหรือไม่ที่จะลบประเภทสินค้านี้?')">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">
                                <i class="bi bi-tags" style="font-size: 2.2rem; color: #FF9259; opacity: 0.5; display: block; margin-bottom: 10px;"></i>
                                ไม่พบข้อมูลประเภทสินค้า
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .category-avatar {
        width: 38px;
        height: 38px;
        background: #FFF2EC;
        color: #FF9259;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        font-family: 'Montserrat', sans-serif;
        flex-shrink: 0;
    }

    .brand-row:hover {
        background-color: #FFF2EC !important;
    }

    .btn-edit:hover {
        background: #FFF2EC;
        color: white !important;
        border-color: #FFF2EC !important;
    }

    .btn-delete:hover {
        background: #E05638;
        color: white !important;
        border-color: #E05638 !important;
    }

    .btn-rim-orange:hover {
        background: #F37C3B !important;
        box-shadow: 0 4px 12px rgba(255, 146, 89, 0.3);
    }
</style>