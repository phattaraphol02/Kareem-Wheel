@model CS66_WebApplication1.Models.Category

@{
    ViewData["Title"] = "เพิ่มประเภทสินค้าใหม่";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="brand-header shadow-sm" style="background: linear-gradient(135deg, #FFFFFF 0%, #FFF2EB 100%); padding: 35px 40px; border-left: 6px solid #FF9760; border-radius: 12px; margin-bottom: 30px; border: 1px solid #EAEAEA;">
        <h2 class="fw-bold mb-0">ลงทะเบียน<span style="color: #FF9760;">ประเภทสินค้าใหม่</span></h2>
        <p class="text-muted small mt-2 mb-0">กรอกข้อมูลรายละเอียดประเภทสินค้าเพื่อเพิ่มลงในฐานข้อมูลหลัก</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card lux-card shadow-sm" style="border: 1px solid #EAEAEA; border-radius: 12px; padding: 40px;">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-4">
                        <label asp-for="Category_Name" class="form-label fw-bold">ชื่อประเภทสินค้า</label>
                        <input asp-for="Category_Name" class="form-control form-control-lg" placeholder="ระบุประเภทสินค้า..." style="border-radius: 8px; border: 1px solid #EAEAEA; padding: 12px;" />
                        <span asp-validation-for="Category_Name" class="text-danger small mt-1"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                            <i class="bi bi-x-circle me-1"></i> ยกเลิก
                        </a>
                        <button type="submit" class="btn btn-rim-orange px-4 py-2 rounded-pill" style="background: #FF9760; color: white; border: none;">
                            <i class="bi bi-check-lg me-1"></i> บันทึกข้อมูล
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}